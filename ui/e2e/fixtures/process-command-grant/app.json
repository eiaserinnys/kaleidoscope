{
  "id": "process-command-fixture",
  "name": "프로그램 실행 시험",
  "requires": { "blocks": 17, "modules": { "assets": 1, "client": 3, "process": 2, "files": 1 } },
  "permissions": [
    { "module": "process", "id": "run", "label": "실행", "command": "python3" },
    { "module": "files", "id": "work", "access": "readwrite", "label": "작업 폴더" }
  ],
  "assets": [{ "id": "process-command-client", "version": 1 }],
  "client": {
    "runtime": "javascript", "entry": { "id": "process-command-client", "version": 1 },
    "outputs": { "status": { "default": "대기" } },
    "actions": ["first", "second"], "process_permissions": ["run"]
  },
  "ui": { "type": "stack", "direction": "column", "children": [
    { "type": "button", "label": "첫 실행", "on_click": { "client": "first" } },
    { "type": "button", "label": "두 번째 실행", "on_click": { "client": "second" } },
    { "type": "text", "value": { "client": "status" } }
  ] }
}
