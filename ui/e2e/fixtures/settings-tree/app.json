{
  "id": "settings-tree-fixture",
  "name": "Claude Code",
  "requires": { "blocks": 18, "modules": { "assets": 1, "client": 4 } },
  "permissions": [],
  "state": {
    "title": "Claude Code",
    "meta": "kaleidoscope-workspace",
    "folder": "workspace",
    "mode": "Auto",
    "model": "Default (recommended)",
    "effort": "High",
    "fast_mode": false,
    "ultracode": false,
    "agent": "Default",
    "new_session": true,
    "test_controls": false
  },
  "assets": [{ "id": "settings-tree-client", "version": 1 }],
  "client": {
    "runtime": "javascript",
    "entry": { "id": "settings-tree-client", "version": 1 },
    "inputs": {
      "title": { "state": "title" },
      "meta": { "state": "meta" },
      "folder": { "state": "folder" }
    },
    "outputs": {
      "available": { "default": true },
      "title": { "default": "Claude Code" },
      "meta": { "default": "kaleidoscope-workspace" },
      "folder": { "default": "kaleidoscope-workspace" },
      "tick": { "default": 0 }
    },
    "actions": ["enable_settings", "disable_settings", "noop"],
    "commands": {},
    "state_keys": [],
    "storage_entries": []
  },
  "settings": {
    "available": { "client": "available" },
    "ui": {
      "type": "stack",
      "direction": "column",
      "gap": "medium",
      "children": [
        {
          "type": "select",
          "label": "Mode",
          "value": { "state": "mode" },
          "options": [
            { "value": "Auto", "label": "Auto" },
            { "value": "Manual", "label": "Manual" }
          ],
          "on_change": { "set_state": "mode" }
        },
        {
          "type": "select",
          "label": "Model",
          "value": { "state": "model" },
          "options": [
            { "value": "Default (recommended)", "label": "Default (recommended)" },
            { "value": "Sonnet", "label": "Sonnet" },
            { "value": "Opus", "label": "Opus" }
          ],
          "on_change": { "set_state": "model" }
        },
        {
          "type": "select",
          "label": "Effort",
          "value": { "state": "effort" },
          "options": [
            { "value": "Low", "label": "Low" },
            { "value": "Medium", "label": "Medium" },
            { "value": "High", "label": "High" }
          ],
          "on_change": { "set_state": "effort" }
        },
        {
          "type": "toggle",
          "label": "Fast mode",
          "value": { "state": "fast_mode" },
          "on_change": { "set_state": "fast_mode" }
        },
        {
          "type": "toggle",
          "label": "Ultracode",
          "value": { "state": "ultracode" },
          "on_change": { "set_state": "ultracode" }
        },
        { "type": "text", "value": "바꾸면 새 세션으로 시작합니다", "style": "meta" },
        {
          "type": "select",
          "label": "Agent",
          "value": { "state": "agent" },
          "options": [
            { "value": "Default", "label": "Default" },
            { "value": "Roselin", "label": "Roselin" }
          ],
          "on_change": { "set_state": "agent" }
        },
        {
          "type": "stack",
          "direction": "row",
          "gap": "medium",
          "children": [
            { "type": "text", "value": "작업 폴더" },
            { "type": "button", "icon": "folder", "label": { "client": "folder" }, "variant": "ghost", "on_click": { "client": "noop" } }
          ]
        },
        {
          "type": "when",
          "value": { "state": "test_controls" },
          "child": {
            "type": "stack",
            "direction": "column",
            "children": [
              { "type": "text", "value": { "client": "tick" } },
              { "type": "button", "label": "설정 버튼 숨기기", "on_click": { "client": "disable_settings" } }
            ]
          }
        }
      ]
    }
  },
  "window_title": {
    "title": { "client": "title" },
    "meta": { "client": "meta" }
  },
  "ui": {
    "type": "stack",
    "direction": "column",
    "gap": "medium",
    "children": [
      { "type": "text", "value": { "client": "tick" } },
      { "type": "button", "label": "설정 버튼 다시 표시", "on_click": { "client": "enable_settings" } }
    ]
  }
}
