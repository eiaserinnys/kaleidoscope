{
  "id": "market",
  "name": "시세와 환율",
  "description": "글로벌 자산 시세와 통화 환율, 구매력 지표를 한눈에 비교하고 환산합니다",
  "requires": {
    "blocks": 9,
    "modules": {
      "http": 1
    }
  },
  "permissions": [
    {
      "module": "http",
      "id": "binance",
      "label": "글로벌 암호화폐 시세 (Binance)",
      "base_url": "https://api.binance.com",
      "paths": [
        "/api/v3/ticker/24hr",
        "/api/v3/klines"
      ]
    },
    {
      "module": "http",
      "id": "frankfurter",
      "label": "유럽중앙은행 통화 환율 (Frankfurter)",
      "base_url": "https://api.frankfurter.dev",
      "paths": [
        "/v1/latest",
        "/v1/2026-09-15.."
      ]
    },
    {
      "module": "http",
      "id": "worldbank",
      "label": "세계은행 물가·구매력 지표 (World Bank)",
      "base_url": "https://api.worldbank.org",
      "paths": [
        "/v2/country/KOR;USA;EMU;DEU;JPN;GBR;CHN;CHE;CAN;AUS/indicator/FP.CPI.TOTL.ZG",
        "/v2/country/KOR;USA;DEU;JPN;GBR;CHN;CHE;CAN;AUS/indicator/PA.NUS.PPP"
      ]
    }
  ],
  "state": {
    "asset": "BTC",
    "currency": "KRW",
    "interval": "1d",
    "quote_unit": "LOCAL",
    "amount_usd": 1000,
    "amount_local": 1335270,
    "selected_candle": null
  },
  "sources": {
    "asset_tickers": {
      "kind": "request",
      "permission": "binance",
      "path": "/api/v3/ticker/24hr",
      "query": {
        "symbols": "[\"BTCUSDT\",\"ETHUSDT\",\"SOLUSDT\",\"XRPUSDT\",\"BNBUSDT\",\"DOGEUSDT\",\"ADAUSDT\",\"AVAXUSDT\"]"
      },
      "refresh_secs": 60
    },
    "asset_candles": {
      "kind": "request",
      "permission": "binance",
      "path": "/api/v3/klines",
      "query": {
        "symbol": {
          "expr": "$state.asset & 'USDT'"
        },
        "interval": {
          "state": "interval"
        },
        "limit": "30"
      },
      "refresh_secs": 60
    },
    "fx_asset_quote": {
      "kind": "request",
      "permission": "frankfurter",
      "path": "/v1/latest",
      "query": {
        "base": "USD",
        "amount": {
          "expr": "$string($round($number($data.asset_tickers[symbol = ($state.asset & 'USDT')].lastPrice), 2))"
        },
        "symbols": "KRW,EUR,JPY,GBP,CNY,CHF,CAD,AUD"
      },
      "refresh_secs": 120
    },
    "fx_series": {
      "kind": "request",
      "permission": "frankfurter",
      "path": "/v1/2026-09-15..",
      "query": {
        "base": {
          "expr": "$data.fx_asset_quote.base"
        },
        "symbols": "KRW,EUR,JPY,GBP,CNY,CHF,CAD,AUD"
      },
      "refresh_secs": 300
    },
    "macro_cpi": {
      "kind": "request",
      "permission": "worldbank",
      "path": "/v2/country/KOR;USA;EMU;DEU;JPN;GBR;CHN;CHE;CAN;AUS/indicator/FP.CPI.TOTL.ZG",
      "query": {
        "format": "json",
        "per_page": "100",
        "date": {
          "expr": "'2020:' & $substring($data.fx_asset_quote.date, 0, 4)"
        }
      },
      "refresh_secs": 600
    },
    "macro_ppp": {
      "kind": "request",
      "permission": "worldbank",
      "path": "/v2/country/KOR;USA;DEU;JPN;GBR;CHN;CHE;CAN;AUS/indicator/PA.NUS.PPP",
      "query": {
        "format": "json",
        "per_page": "100",
        "date": {
          "expr": "'2020:' & $substring($data.fx_asset_quote.date, 0, 4)"
        }
      },
      "refresh_secs": 600
    },
    "trend_btc": {
      "kind": "request",
      "permission": "binance",
      "path": "/api/v3/klines",
      "query": {
        "symbol": "BTCUSDT",
        "interval": "1h",
        "limit": "24"
      },
      "refresh_secs": 60
    },
    "trend_eth": {
      "kind": "request",
      "permission": "binance",
      "path": "/api/v3/klines",
      "query": {
        "symbol": "ETHUSDT",
        "interval": "1h",
        "limit": "24"
      },
      "refresh_secs": 60
    },
    "trend_sol": {
      "kind": "request",
      "permission": "binance",
      "path": "/api/v3/klines",
      "query": {
        "symbol": "SOLUSDT",
        "interval": "1h",
        "limit": "24"
      },
      "refresh_secs": 60
    },
    "trend_xrp": {
      "kind": "request",
      "permission": "binance",
      "path": "/api/v3/klines",
      "query": {
        "symbol": "XRPUSDT",
        "interval": "1h",
        "limit": "24"
      },
      "refresh_secs": 60
    },
    "trend_bnb": {
      "kind": "request",
      "permission": "binance",
      "path": "/api/v3/klines",
      "query": {
        "symbol": "BNBUSDT",
        "interval": "1h",
        "limit": "24"
      },
      "refresh_secs": 60
    },
    "trend_doge": {
      "kind": "request",
      "permission": "binance",
      "path": "/api/v3/klines",
      "query": {
        "symbol": "DOGEUSDT",
        "interval": "1h",
        "limit": "24"
      },
      "refresh_secs": 60
    },
    "trend_ada": {
      "kind": "request",
      "permission": "binance",
      "path": "/api/v3/klines",
      "query": {
        "symbol": "ADAUSDT",
        "interval": "1h",
        "limit": "24"
      },
      "refresh_secs": 60
    },
    "trend_avax": {
      "kind": "request",
      "permission": "binance",
      "path": "/api/v3/klines",
      "query": {
        "symbol": "AVAXUSDT",
        "interval": "1h",
        "limit": "24"
      },
      "refresh_secs": 60
    }
  },
  "ui": {
    "type": "stack",
    "direction": "column",
    "gap": "none",
    "fill": 4,
    "children": [
      {
        "type": "toolbar",
        "start": [
          {
            "type": "select",
            "style": "segmented",
            "value": {
              "state": "asset"
            },
            "options": [
              {
                "value": "BTC",
                "label": "BTC"
              },
              {
                "value": "ETH",
                "label": "ETH"
              },
              {
                "value": "SOL",
                "label": "SOL"
              },
              {
                "value": "XRP",
                "label": "XRP"
              },
              {
                "value": "BNB",
                "label": "BNB"
              },
              {
                "value": "DOGE",
                "label": "DOGE"
              }
            ],
            "on_change": [
              {
                "set_state": "asset"
              },
              {
                "set_state": "selected_candle",
                "value": null
              }
            ]
          },
          {
            "type": "select",
            "style": "dropdown",
            "value": {
              "state": "currency"
            },
            "options": [
              {
                "value": "KRW",
                "label": "KRW · 대한민국 원"
              },
              {
                "value": "EUR",
                "label": "EUR · 유로"
              },
              {
                "value": "JPY",
                "label": "JPY · 일본 엔"
              },
              {
                "value": "GBP",
                "label": "GBP · 영국 파운드"
              },
              {
                "value": "CNY",
                "label": "CNY · 중국 위안"
              },
              {
                "value": "CHF",
                "label": "CHF · 스위스 프랑"
              },
              {
                "value": "CAD",
                "label": "CAD · 캐나다 달러"
              },
              {
                "value": "AUD",
                "label": "AUD · 호주 달러"
              }
            ],
            "on_change": [
              {
                "set_state": "currency"
              },
              {
                "set_state": "amount_local",
                "value": {
                  "expr": "$state.amount_usd != null ? $round($state.amount_usd * ($lookup($data.fx_asset_quote.rates, $event) / $data.fx_asset_quote.amount), 2) : null"
                }
              },
              {
                "set_state": "selected_candle",
                "value": null
              }
            ]
          },
          {
            "type": "select",
            "style": "segmented",
            "value": {
              "state": "interval"
            },
            "options": [
              {
                "value": "4h",
                "label": "4시간"
              },
              {
                "value": "1d",
                "label": "일봉"
              },
              {
                "value": "1w",
                "label": "주봉"
              }
            ],
            "on_change": [
              {
                "set_state": "interval"
              },
              {
                "set_state": "selected_candle",
                "value": null
              }
            ]
          },
          {
            "type": "select",
            "style": "segmented",
            "value": {
              "state": "quote_unit"
            },
            "options": [
              {
                "value": "LOCAL",
                "label": "현지 통화"
              },
              {
                "value": "USD",
                "label": "USD"
              }
            ],
            "on_change": [
              {
                "set_state": "quote_unit"
              },
              {
                "set_state": "selected_candle",
                "value": null
              }
            ]
          }
        ],
        "end": [
          {
            "type": "button",
            "label": "새로고침",
            "icon": "refresh-cw",
            "icon_only": true,
            "on_click": [
              {
                "refresh": []
              }
            ]
          }
        ]
      },
      {
        "type": "metrics",
        "columns": 4,
        "items": {
          "expr": "(\n $p := $number($data.asset_tickers[symbol = ($state.asset & 'USDT')].lastPrice); $rate := ($lookup($data.fx_asset_quote.rates, $state.currency) / $data.fx_asset_quote.amount); $ppp := ($id := $lookup({\"KRW\":\"KOR\",\"EUR\":\"DEU\",\"JPY\":\"JPN\",\"GBP\":\"GBR\",\"CNY\":\"CHN\",\"CHF\":\"CHE\",\"CAD\":\"CAN\",\"AUD\":\"AUS\"}, $state.currency); $data.macro_ppp[1][countryiso3code = $id and value != null][0].value); $cpi := ($id := $lookup({\"KRW\":\"KOR\",\"EUR\":\"EMU\",\"JPY\":\"JPN\",\"GBP\":\"GBR\",\"CNY\":\"CHN\",\"CHF\":\"CHE\",\"CAD\":\"CAN\",\"AUD\":\"AUS\"}, $state.currency); $data.macro_cpi[1][countryiso3code = $id and value != null][0]);\n $us := $data.macro_cpi[1][countryiso3code = 'USA' and value != null][0].value;\n $cut := $fromMillis($toMillis($data.fx_asset_quote.date & 'T00:00:00Z') - 2592000000, '[Y0001]-[M01]-[D01]'); $keys := $sort($keys($data.fx_series.rates))[$ >= $cut]; $first := $lookup($lookup($data.fx_series.rates,$keys[0]),$state.currency); $last := $lookup($lookup($data.fx_series.rates,$keys[$count($keys)-1]),$state.currency);\n [{\"label\":\"1 \" & $state.asset & \" (\" & $state.currency & \")\", \"value\":$formatNumber($p*$rate, \"#,##0.##\"),\"unit\":$state.currency,\"featured\":true,\"subtext\":\"USD \" & $formatNumber($p, \"#,##0.##\") & \" · 고 \" & $formatNumber($number($data.asset_tickers[symbol = ($state.asset & 'USDT')].highPrice), \"#,##0.##\") & \" / 저 \" & $formatNumber($number($data.asset_tickers[symbol = ($state.asset & 'USDT')].lowPrice), \"#,##0.##\"),\"badge\":$string($data.asset_tickers[symbol = ($state.asset & 'USDT')].priceChangePercent) & \"%\"},\n {\"label\":\"USD / \" & $state.currency,\"value\":$formatNumber($rate, \"#,##0.####\"),\"unit\":$state.currency,\"subtext\":$data.fx_asset_quote.date & \" · \" & $keys[0] & \"~\" & $keys[$count($keys)-1],\"badge\":$string($round(($last-$first)/$first*100,2)) & \"%\"},\n {\"label\":\"PPP 구매력 환율\",\"value\":$formatNumber($ppp, \"#,##0.##\"),\"unit\":$state.currency,\"subtext\":\"자산 실질 가치 $\" & $formatNumber($p*$rate/$ppp, \"#,##0.##\"),\"badge\":$string($round(($rate-$ppp)/$ppp*100,2)) & \"%\"},\n {\"label\":\"연간 물가 CPI\",\"value\":$round($cpi.value,2),\"unit\":\"%\",\"subtext\":$cpi.date & \" · 미국 대비 \" & $string($round($cpi.value-$us,2)) & \"%p\", \"badge\":$cpi.value > 2 ? \"상승\" : \"안정\"}])"
        }
      },
      {
        "type": "toolbar",
        "start": [
          {
            "type": "input",
            "kind": "number",
            "value": {
              "state": "amount_usd"
            },
            "placeholder": "USD",
            "on_change": [
              {
                "set_state": "amount_usd"
              },
              {
                "set_state": "amount_local",
                "value": {
                  "expr": "$event != null ? $round($number($event)*($lookup($data.fx_asset_quote.rates, $state.currency) / $data.fx_asset_quote.amount),2) : null"
                }
              }
            ]
          },
          {
            "type": "text",
            "style": "meta",
            "value": {
              "expr": "'⇄ ' & $string($round($state.amount_usd / $number($data.asset_tickers[symbol = ($state.asset & 'USDT')].lastPrice), 4)) & ' ' & $state.asset & ' · PPP $' & $string($round($state.amount_local / ($id := $lookup({\"KRW\":\"KOR\",\"EUR\":\"DEU\",\"JPY\":\"JPN\",\"GBP\":\"GBR\",\"CNY\":\"CHN\",\"CHF\":\"CHE\",\"CAD\":\"CAN\",\"AUD\":\"AUS\"}, $state.currency); $data.macro_ppp[1][countryiso3code = $id and value != null][0].value), 2))"
            }
          },
          {
            "type": "input",
            "kind": "number",
            "value": {
              "state": "amount_local"
            },
            "placeholder": "현지 통화",
            "on_change": [
              {
                "set_state": "amount_local"
              },
              {
                "set_state": "amount_usd",
                "value": {
                  "expr": "$event != null ? $round($number($event)/($lookup($data.fx_asset_quote.rates, $state.currency) / $data.fx_asset_quote.amount),2) : null"
                }
              }
            ]
          }
        ],
        "end": [
          {
            "type": "button",
            "label": "$1,000",
            "on_click": [
              {
                "set_state": "amount_usd",
                "value": {
                  "expr": "1000"
                }
              },
              {
                "set_state": "amount_local",
                "value": {
                  "expr": "$round((1000) * ($lookup($data.fx_asset_quote.rates, $state.currency) / $data.fx_asset_quote.amount), 2)"
                }
              }
            ]
          },
          {
            "type": "button",
            "label": "1단위 자산",
            "on_click": [
              {
                "set_state": "amount_usd",
                "value": {
                  "expr": "$number($data.asset_tickers[symbol = ($state.asset & 'USDT')].lastPrice)"
                }
              },
              {
                "set_state": "amount_local",
                "value": {
                  "expr": "$round(($number($data.asset_tickers[symbol = ($state.asset & 'USDT')].lastPrice)) * ($lookup($data.fx_asset_quote.rates, $state.currency) / $data.fx_asset_quote.amount), 2)"
                }
              }
            ]
          }
        ]
      },
      {
        "type": "section",
        "title": {
          "expr": "$state.asset & ' · ' & ($state.quote_unit = 'LOCAL' ? $state.currency : 'USD') & ' 캔들 차트 (30봉)'"
        },
        "meta": {
          "expr": "$state.selected_candle ? ($state.selected_candle.x & ' · 시 ' & $string($state.selected_candle.open) & ' 고 ' & $string($state.selected_candle.high) & ' 저 ' & $string($state.selected_candle.low) & ' 종 ' & $string($state.selected_candle.close)) : $data_meta.asset_candles.updated_time"
        },
        "child": {
          "type": "chart",
          "kind": "candlestick",
          "height": "medium",
          "series": {
            "expr": "($rate := $state.quote_unit = 'LOCAL' ? ($lookup($data.fx_asset_quote.rates, $state.currency) / $data.fx_asset_quote.amount) : 1; [{\"key\":\"price\",\"name\":$state.asset,\"points\":[$map($data.asset_candles,function($k){{\"x\":$fromMillis($k[0], '[M01]-[D01] [H01]:[m01]'),\"open\":$round($number($k[1])*$rate,2),\"high\":$round($number($k[2])*$rate,2),\"low\":$round($number($k[3])*$rate,2),\"close\":$round($number($k[4])*$rate,2)}})]}])"
          },
          "on_select": [
            {
              "set_state": "selected_candle",
              "value": {
                "expr": "$item"
              }
            }
          ]
        }
      },
      {
        "type": "split",
        "direction": "row",
        "sizes": [
          54,
          46
        ],
        "children": [
          {
            "type": "section",
            "title": "통화별 환율 · 구매력(PPP) · 물가(CPI)",
            "meta": "ECB · World Bank 연쇄",
            "child": {
              "type": "table",
              "rows": {
                "expr": "($rows := [{\"code\":\"KRW\",\"name\":\"대한민국 원\",\"ppp\":\"KOR\",\"cpi\":\"KOR\"},{\"code\":\"EUR\",\"name\":\"유로\",\"ppp\":\"DEU\",\"cpi\":\"EMU\"},{\"code\":\"JPY\",\"name\":\"일본 엔\",\"ppp\":\"JPN\",\"cpi\":\"JPN\"},{\"code\":\"GBP\",\"name\":\"영국 파운드\",\"ppp\":\"GBR\",\"cpi\":\"GBR\"},{\"code\":\"CNY\",\"name\":\"중국 위안\",\"ppp\":\"CHN\",\"cpi\":\"CHN\"},{\"code\":\"CHF\",\"name\":\"스위스 프랑\",\"ppp\":\"CHE\",\"cpi\":\"CHE\"},{\"code\":\"CAD\",\"name\":\"캐나다 달러\",\"ppp\":\"CAN\",\"cpi\":\"CAN\"},{\"code\":\"AUD\",\"name\":\"호주 달러\",\"ppp\":\"AUS\",\"cpi\":\"AUS\"}]; $cut := $fromMillis($toMillis($data.fx_asset_quote.date & 'T00:00:00Z') - 2592000000, '[Y0001]-[M01]-[D01]'); $dates := $sort($keys($data.fx_series.rates))[$ >= $cut]; $map($rows,function($r){(\n $code := $r.code; $rate := $lookup($data.fx_asset_quote.rates,$code)/$data.fx_asset_quote.amount;\n $values := [$map($dates,function($d){$lookup($lookup($data.fx_series.rates,$d),$code)})];\n $ppp := $data.macro_ppp[1][countryiso3code = $r.ppp and value != null][0].value;\n $cpi := $data.macro_cpi[1][countryiso3code = $r.cpi and value != null][0].value;\n {\"key\":$code,\"currency\":$code & \" · \" & $r.name,\"asset_quote\":$lookup($data.fx_asset_quote.rates,$code),\"fx_rate\":$rate,\"fx_delta\":($values[$count($values)-1]-$values[0])/$values[0]*100,\"fx_spark\":$values,\"ppp_gap\":($rate-$ppp)/$ppp*100,\"cpi\":$cpi})}))"
              },
              "columns": [
                {
                  "field": "currency",
                  "label": "통화",
                  "format": "text",
                  "width": "medium"
                },
                {
                  "field": "asset_quote",
                  "label": "자산 환산가",
                  "format": "number",
                  "width": "medium"
                },
                {
                  "field": "fx_rate",
                  "label": "명목 환율",
                  "format": "number",
                  "width": "narrow"
                },
                {
                  "field": "fx_delta",
                  "label": "월간 등락",
                  "format": "delta",
                  "width": "narrow"
                },
                {
                  "field": "fx_spark",
                  "label": "환율 추이",
                  "format": "sparkline",
                  "width": "medium"
                },
                {
                  "field": "ppp_gap",
                  "label": "PPP 괴리",
                  "format": "delta",
                  "width": "narrow"
                },
                {
                  "field": "cpi",
                  "label": "물가 CPI",
                  "format": "delta",
                  "width": "narrow"
                }
              ],
              "selected": {
                "state": "currency"
              },
              "on_select": [
                {
                  "set_state": "currency"
                },
                {
                  "set_state": "amount_local",
                  "value": {
                    "expr": "$state.amount_usd != null ? $round($state.amount_usd * ($lookup($data.fx_asset_quote.rates, $event) / $data.fx_asset_quote.amount), 2) : null"
                  }
                },
                {
                  "set_state": "selected_candle",
                  "value": null
                }
              ]
            }
          },
          {
            "type": "section",
            "title": "글로벌 암호화폐 시세",
            "meta": "Binance 24h",
            "child": {
              "type": "table",
              "rows": {
                "expr": "($names := {\"BTC\":\"Bitcoin\",\"ETH\":\"Ethereum\",\"SOL\":\"Solana\",\"XRP\":\"XRP\",\"BNB\":\"BNB\",\"DOGE\":\"Dogecoin\",\"ADA\":\"Cardano\",\"AVAX\":\"Avalanche\"}; $trends := {\"BTC\":$data.trend_btc,\"ETH\":$data.trend_eth,\"SOL\":$data.trend_sol,\"XRP\":$data.trend_xrp,\"BNB\":$data.trend_bnb,\"DOGE\":$data.trend_doge,\"ADA\":$data.trend_ada,\"AVAX\":$data.trend_avax}; $map($data.asset_tickers,function($t){(\n $asset := $substringBefore($t.symbol,'USDT'); $history := $lookup($trends,$asset);\n {\"key\":$asset,\"asset\":$asset & \" · \" & $lookup($names,$asset),\"local_price\":$number($t.lastPrice)*($lookup($data.fx_asset_quote.rates, $state.currency) / $data.fx_asset_quote.amount),\"usd_price\":$number($t.lastPrice),\"change_24h\":$number($t.priceChangePercent),\"spark_24h\":[$map($history,function($k){$number($k[4])})]})}))"
              },
              "columns": [
                {
                  "field": "asset",
                  "label": "자산",
                  "format": "text",
                  "width": "medium"
                },
                {
                  "field": "local_price",
                  "label": "현지 시세",
                  "format": "number",
                  "width": "medium"
                },
                {
                  "field": "usd_price",
