                    {
                      "type": "select",
                      "label": "스토어",
                      "label_position": "hidden",
                      "placeholder": "스토어 고르기",
                      "value": {"state": "custom_store"},
                      "options": {"expr": "(\n  $id := $state.selected;\n  [$map($data.catalog.stores, function($s, $i) { $s.state = 'ready' and $count($s.items[id = $id]) > 0 ? { \"value\": $s.server, \"label\": ($i = 0 ? '기본 앱스토어' : '사설 ' & $string($i)) } : null })][$ != null]\n)"},
