{
  "id": "store",
  "name": "앱스토어",
  "description": "스토어의 앱을 찾아 설치하고, 설치한 앱을 업데이트하거나 지웁니다",
  "requires": {"blocks": 63, "modules": {"store": 4, "storage": 2, "assets": 1, "shell": 2}},
  "single_window": true,
  "badge": {"expr": "$count($apps[origin != null and $not(modified) and latest.compatible = true and latest.release > origin.release])"},
  "icon": {"asset": "builtin-icon-store", "version": 2},
  "assets": [{"id": "builtin-icon-store", "version": 2}],
  "permissions": [{"module": "store", "id": "catalog", "label": "앱 설치"}],
  "storage": {
    "entries": [
      {
        "id": "store",
        "key": "settings/store",
        "kind": "json",
        "label": "스토어",
        "presentation": "hidden",
        "description": "앱 목록을 읽어 올 곳",
        "schema": {"type": "string", "enum": ["default", "custom"]},
        "default": "default"
      },
      {
        "id": "custom_url",
        "key": "settings/custom-url",
        "kind": "json",
        "label": "직접 입력 주소",
        "presentation": "hidden",
        "description": "직접 입력을 골랐을 때 읽을 https 주소",
        "schema": {"type": "string"},
        "default": ""
      },
      {
        "id": "servers",
        "key": "settings/servers",
        "kind": "json",
        "label": "사설 스토어",
        "presentation": "hidden",
        "schema": {"type": ["array", "null"], "items": {"type": "string"}},
        "default": null
      },
      {
        "id": "invites",
        "key": "settings/invites",
        "kind": "json",
        "label": "사설 스토어 초대코드",
        "presentation": "hidden",
        "description": "사설 스토어 주소별 초대코드",
        "schema": {"type": ["object", "null"], "additionalProperties": {"type": "string"}},
        "default": null
      }
    ]
  },
  "state": {"category": "", "query": "", "selected": null, "selected_name": "", "selected_store": null, "new_server": "", "new_invite": "", "selected_key": null, "shortcut_added": null, "custom_store": null},
  "sources": {
    "catalog": {
      "kind": "store",
      "store": "indexes",
      "permission": "catalog",
      "servers": {"expr": "($invites := ($type($storage.invites) = 'object' ? $storage.invites : {}); $append(['https://kaleidoscope.eiaserinnys.me/appstore'], ($type($storage.servers) = 'array' ? $storage.servers : ($trim($storage.custom_url) != '' ? [$trim($storage.custom_url)] : []))))"}
    },
    "detail": {
      "kind": "store",
      "store": "app",
      "permission": "catalog",
      "server": {"state": "selected_store"},
      "id": {"expr": "$state.selected != null and ($state.selected_store in $data.catalog.stores.server or $state.selected_store in $apps.origin.store_url) ? $state.selected : null"}
    },
    "convert": {
      "kind": "store",
      "store": "app",
      "permission": "catalog",
      "server": {"expr": "(\n  $id := $state.selected;\n  $cands := [$data.catalog.stores[state = 'ready' and $count(items[id = $id]) > 0].server];\n  ($state.custom_store != null and $state.custom_store in $cands) ? $state.custom_store : null\n)"},
      "id": {"expr": "$state.selected != null and $state.selected_store = null and $count($apps[id = $state.selected and builtin = false and origin = null]) > 0 ? $state.selected : null"}
    }
  },
  "window_title": {"title": "앱스토어"},
  "ui": {
    "type": "split",
    "direction": "row",
    "sizes": [18, 47, 35],
    "column_below": 640,
    "children": [
      {
        "type": "stack",
        "direction": "column",
        "gap": "none",
        "fill": 1,
        "children": [
          {"type": "toolbar", "start": [{"type": "text", "value": "카테고리", "format": "plain", "style": "title"}]},
          {
            "type": "stack",
            "direction": "column",
            "gap": "none",
            "children": [
              {
                "type": "list",
                "layout": "rows",
                "items": {"expr": "(\n  $all := [$data.catalog.stores[state = 'ready'].items];\n  $installed := $apps[origin != null];\n  $updates := $installed[$not(modified) and latest.compatible = true and latest.release > origin.release];\n  $cats := $sort($distinct($all.category));\n  $append($append([{ \"key\": \"\", \"title\": \"전체\", \"meta\": $string($count($all)) }],\n    [$cats.( $c := $; { \"key\": $c, \"title\": $c, \"meta\": $string($count($all[category = $c])) } )]),\n    [{ \"key\": \"__updates\", \"title\": \"업데이트\", \"meta\": $string($count($updates)) },\n     { \"key\": \"__installed\", \"title\": \"설치됨\", \"meta\": $string($count($installed)) }])\n)"},
                "selected": {"state": "category"},
                "on_select": [{"set_state": "category"}]
              },
              {
                "type": "list",
                "layout": "rows",
                "items": {"expr": "[{ \"key\": \"__custom\", \"title\": \"커스텀 앱\", \"meta\": $string($count($apps[builtin = false and origin = null])) }]"},
                "selected": {"state": "category"},
                "on_select": [{"set_state": "category"}]
              }
            ]
          }
        ]
      },
      {
        "type": "stack",
        "direction": "column",
        "gap": "none",
        "fill": [2, 3, 4],
        "children": [
          {
            "type": "when",
            "value": {"expr": "$state.category != '__custom'"},
            "child": {
              "type": "toolbar",
              "start": [{"type": "input", "kind": "search", "value": {"state": "query"}, "on_change": {"set_state": "query"}, "placeholder": "앱 이름이나 id로 찾기"}],
              "end": [{"type": "button", "label": "다시 받기", "icon": "refresh-cw", "icon_only": true, "variant": "ghost", "on_click": [{"refresh": ["catalog", "detail", "convert"]}]}]
            }
          },
          {
            "type": "when",
            "value": {"expr": "$state.category = '__custom'"},
            "child": {
              "type": "toolbar",
              "start": [{"type": "input", "kind": "search", "value": {"state": "query"}, "on_change": {"set_state": "query"}, "placeholder": "앱 이름이나 id로 찾기"}],
              "end": [
                {"type": "button", "label": "파일에서 가져오기", "icon": "upload", "icon_only": true, "variant": "ghost", "on_click": [{"shell.import_app": {}}]},
                {"type": "button", "label": "다시 받기", "icon": "refresh-cw", "icon_only": true, "variant": "ghost", "on_click": [{"refresh": ["catalog", "detail", "convert"]}]}
              ]
            }
          },
          {
            "type": "when",
            "value": {"expr": "$state.category != '__custom'"},
            "child": {
              "type": "list",
              "layout": "icons",
              "items": {"expr": "(\n  $q := $lowercase($trim($state.query)); $category := $state.category;\n  $stores := [$data.catalog.stores];\n  $ready := [$stores[state = 'ready']];\n  $all := [$ready.items];\n  $first := $ready[0].server;\n  $installedAll := [$apps[origin != null]];\n  $updatesAll := [$installedAll[$not(modified) and latest.compatible = true and latest.release > origin.release]];\n  $chosenAll := $category = '__updates' ? $updatesAll : $installedAll;\n  $storeGroups := [$map($stores, function($s, $index) { (\n    $installed := [$installedAll[origin.store_url = $s.server]];\n    $updates := [$updatesAll[origin.store_url = $s.server]];\n    $chosen := $category = '__updates' ? $updates : $installed;\n    $pool := $category = '__installed' or $category = '__updates'\n      ? $append([$s.items[id in $chosen.id]], [$chosen[$not(id in $s.items.id)].{ \"id\": id, \"name\": name, \"icon\": icon }])\n      : ($category = '' ? $s.items : [$s.items[category = $category]]);\n    $hits := [$pool[$q = '' or $contains($lowercase(name), $q) or $contains($lowercase(id), $q) or $contains($lowercase($string(summary)), $q)]];\n    $direct := $s.state = 'ready' and $s.server = $first and $category != '__updates' and $category != '__installed' and $q != '' and $not($q in $all.id) and $match($q, /^[a-z0-9-]{1,64}$/)\n      ? [{ \"id\": $q, \"name\": $q }] : [];\n    $items := [$map($append($hits, $direct), function($a) { { \"key\": $string([$s.server, $a.id]), \"title\": $a.name, \"image\": $a.icon, \"dot\": $a.id in $updates.id, \"server\": $s.server, \"id\": $a.id } })];\n    $group := { \"key\": $s.server, \"server\": $s.server, \"title\": $index = 0 ? '기본 앱스토어' : '사설 ' & $string($index), \"items\": $items };\n    $merge([$group, $index = 0 ? {} : { \"meta\": $s.server },\n      $s.state = 'ready' ? ($count($items) = 0 ? { \"status\": { \"state\": \"empty\" } } : {})\n      : $s.state = 'permission_required' ? { \"status\": { \"state\": \"empty\", \"message\": \"이 PC에서 연결을 허용하면 앱을 볼 수 있습니다.\" }, \"action\": \"allow\" }\n      : $merge([{ \"status\": { \"state\": \"error\", \"message\": $s.error.message, \"code\": $s.error.id } },\n          $s.error.id = 'STORECLIENT_URL_COMPONENT_INVALID' ? {} : { \"action\": \"retry\" }])])\n  ) })];\n  $orphans := [$chosenAll[$not(origin.store_url in $stores.server) and ($q = '' or $contains($lowercase(name), $q) or $contains($lowercase(id), $q))]];\n  $other := ($category = '__installed' or $category = '__updates') and $count($orphans) > 0\n    ? [{ \"key\": \"other-stores\", \"title\": \"그 밖의 스토어\", \"items\": [$map($orphans, function($a) { { \"key\": $string([$a.origin.store_url, $a.id]), \"title\": $a.name, \"image\": $a.icon, \"dot\": $not($a.modified) and $a.latest.compatible = true and $a.latest.release > $a.origin.release, \"server\": $a.origin.store_url, \"id\": $a.id } })] }] : [];\n  $append($storeGroups, $other)\n)"},
              "selected": {"state": "selected_key"},
              "on_select": [
                {"set_state": "selected_key", "value": {"expr": "$item.key"}},
                {"set_state": "selected", "value": {"expr": "$item.id"}},
                {"set_state": "selected_store", "value": {"expr": "$item.server"}},
                {"set_state": "selected_name", "value": {"expr": "$item.title"}}
              ],
              "grouped": true,
              "group_actions": [
                {"key": "allow", "label": "연결 허용", "on_click": [{"store.allow_server": {"permission": "catalog", "server": {"expr": "$item.server"}}}]},
                {"key": "retry", "label": "다시 받기", "on_click": [{"refresh": ["catalog", "detail"]}]}
              ]
            }
          },
          {
            "type": "when",
            "value": {"expr": "$state.category = '__custom' and $count($apps[builtin = false and origin = null]) > 0"},
            "child": {
              "type": "list",
              "layout": "icons",
              "items": {"expr": "(\n  $q := $lowercase($trim($state.query));\n  [$map($apps[builtin = false and origin = null and ($q = '' or $contains($lowercase(name), $q) or $contains($lowercase(id), $q))], function($a) { { \"key\": $a.id, \"title\": $a.name, \"image\": $a.icon, \"dot\": false, \"server\": null, \"id\": $a.id } })]\n)"},
              "selected": {"state": "selected_key"},
              "on_select": [
                {"set_state": "selected_key", "value": {"expr": "$item.key"}},
                {"set_state": "selected", "value": {"expr": "$item.id"}},
                {"set_state": "selected_store", "value": {"expr": "$item.server"}},
                {"set_state": "selected_name", "value": {"expr": "$item.title"}},
                {"set_state": "custom_store", "value": {"expr": "($cands := [$data.catalog.stores[state = 'ready' and $count(items[id = $item.id]) > 0].server]; $count($cands) = 1 ? $cands[0] : null)"}}
              ]
            }
          },
          {
            "type": "when",
            "value": {"expr": "$state.category = '__custom' and $count($apps[builtin = false and origin = null]) = 0"},
            "child": {
              "type": "stack",
              "direction": "column",
              "gap": "none",
              "place": "center",
              "children": [{"type": "text", "value": "커스텀 앱이 없습니다.", "format": "plain", "style": "meta"}]
            }
          }
        ]
      },
      {
        "type": "stack",
        "direction": "column",
        "gap": "none",
        "fill": [2, 3, 4],
        "children": [
          {
            "type": "when",
            "value": {"expr": "$state.selected != null and $not($state.selected_store = null and $count($apps[id = $state.selected and builtin = false and origin = null]) > 0)"},
            "child": {
              "type": "toolbar",
              "start": [
                {
                  "type": "text",
                  "value": {"expr": "$state.selected != null and ($state.selected_store in $data.catalog.stores.server or $state.selected_store in $apps.origin.store_url) ? $state.selected_name : ''"},
                  "format": "plain",
                  "style": "title"
                }
              ]
            }
          },
          {
            "type": "when",
            "value": {"expr": "$state.selected != null and $state.selected_store = null and $count($apps[id = $state.selected and builtin = false and origin = null]) > 0"},
            "child": {
              "type": "toolbar",
              "start": [{"type": "text", "value": {"state": "selected_name"}, "format": "plain", "style": "title"}]
            }
          },
          {
            "type": "when",
            "value": {"expr": "$state.selected != null and ($state.selected_store in $data.catalog.stores.server or $state.selected_store in $apps.origin.store_url) and $data_meta.detail.state = 'ready'"},
            "child": {
              "type": "stack",
              "direction": "column",
              "gap": "medium",
              "children": [
                {
                  "type": "properties",
                  "fields": [
                    {"label": "제작자", "value": {"expr": "$data.detail.publisher"}, "format": "text"},
                    {"label": "분류", "value": {"expr": "$data.detail.category"}, "format": "text"},
                    {"label": "판", "value": {"expr": "$string($data.detail.release)"}, "format": "text"},
                    {"label": "올린 날", "value": {"expr": "$fromMillis($toMillis($data.detail.releases[release = $data.detail.release].published_at), '[Y0001]년 [M1]월 [D1]일', '+0900')"}, "format": "text"},
                    {
                      "label": "권한",
                      "value": {"expr": "( $d := $data.detail; $p := [$d.permissions.{ \"text\": label ? label : module, \"color\": module = 'process' ? '#a9363d' : '#6b7280' }]; $b := [$d.badges[$ = 'worker'].{ \"text\": \"서버 실행 코드\", \"color\": \"#a9363d\" }]; $all := $append($p, $b); $count($all) = 0 ? null : $all )"},
                      "format": "badge"
                    },
                    {"label": "권한", "value": {"expr": "$count($data.detail.permissions) + $count($data.detail.badges[$ = 'worker']) = 0 ? '없음' : null"}, "format": "text"},
                    {
                      "label": "요구 쉘",
                      "value": {"expr": "$data.detail.compatible ? null : '블록 세트 ' & $string($data.detail.requires.blocks) & ', 쉘을 올려야 설치합니다'"},
                      "format": "text"
                    },
                    {
                      "label": "상태",
                      "value": {"expr": "(\n  $a := $apps[id = $state.selected]; $d := $data.detail;\n  $names := [$map($data.catalog.stores, function($s, $i) { $s.server = $a.origin.store_url ? ($i = 0 ? '기본 앱스토어' : '사설 ' & $string($i)) : null })][$ != null];\n  $not($exists($a)) ? '설치 전' : ($a.origin = null ? '같은 id의 다른 앱이 있어 설치할 수 없습니다' :\n    ($a.origin.store_url != $state.selected_store ? ($count($names) > 0 ? $names[0] : '다른 스토어') & '에서 설치한 앱입니다' :\n      ($a.modified ? '설치 뒤 고친 앱이라 업데이트하지 않습니다' : ($a.origin.release < $d.release ? $string($a.origin.release) & '판 설치됨, 새 판 있음' : $string($a.origin.release) & '판 설치됨'))))\n)"},
                      "format": "text"
                    },
                    {"label": "id", "value": {"state": "selected"}, "format": "code"}
                  ]
                },
                {
                  "type": "when",
                  "value": {"expr": "$count($data.detail.screenshots) > 0"},
                  "child": {
                    "type": "list",
                    "layout": "grid",
                    "items": {"expr": "[$map($data.detail.screenshots, function($s, $i) { { \"key\": $string($i), \"title\": '', \"image\": $s } })]"}
                  }
                },
                {"type": "text", "value": {"expr": "$data.detail.description"}, "format": "markdown", "style": "body"}
              ]
            }
          },
          {
            "type": "when",
            "value": {"expr": "$state.selected != null and ($state.selected_store in $data.catalog.stores.server or $state.selected_store in $apps.origin.store_url) and $data_meta.detail.state != 'ready'"},
            "child": {"type": "text", "value": {"expr": "$data.detail.name"}}
          },
          {
            "type": "when",
            "value": {"expr": "$state.selected != null and $state.selected_store = null and $count($apps[id = $state.selected and builtin = false and origin = null]) > 0"},
            "child": {
              "type": "stack",
              "direction": "column",
              "gap": "medium",
              "children": [
                {
                  "type": "properties",
                  "fields": [
                    {"label": "판", "value": {"expr": "$string($apps[id = $state.selected].version)"}, "format": "text"},
                    {"label": "id", "value": {"state": "selected"}, "format": "code"}
                  ]
                }
              ]
            }
          },
          {
            "type": "when",
            "value": {"expr": "$state.selected != null and $count($apps[id = $state.selected]) > 0"},
            "child": {
              "type": "toolbar",
              "start": [],
              "end": [
                {
                  "type": "button",
                  "label": {"expr": "$state.shortcut_added = $state.selected ? '바탕화면에 있음' : '바탕화면에 추가'"},
                  "disabled": {"expr": "$state.shortcut_added = $state.selected"},
                  "on_click": [
                    {"shell.add_shortcut": {"app_id": {"state": "selected"}}},
                    {"set_state": "shortcut_added", "value": {"state": "selected"}}
                  ]
                },
                {
                  "type": "button",
                  "variant": {"expr": "(\n  $id := $state.selected;\n  $a := $apps[id = $id];\n  $d := $data.detail;\n  $custom := $state.selected_store = null and $count($apps[id = $id and builtin = false and origin = null]) > 0;\n  $candidates := $count([$lookup($data, 'catalog').stores[state = 'ready' and $count(items[id = $id]) > 0]]) > 0;\n  $ready := $data_meta.detail.state = 'ready' and $d.compatible;\n  $installed := $count($apps[id = $id and origin != null]) > 0;\n  $same := $exists($a) and $a.origin != null and $a.origin.store_url = $state.selected_store and $a.origin.store_app_id = $id;\n  $convert := $exists($a) and $a.builtin = false and ($a.origin = null or $not($same) or $a.modified);\n  $emphasis := $custom ? $candidates : ($installed\n    ? ($ready and ($convert ? ($not($same) or $a.origin.release <= $d.release) : $a.origin.release < $d.release))\n    : ($ready and $not($exists($a))));\n  $emphasis ? 'default' : 'primary'\n)"},
                  "label": "열기",
                  "on_click": [{"shell.open": {"app_id": {"state": "selected"}}}]
                }
              ]
            }
          },
          {
            "type": "when",
            "value": {"expr": "( $a := $apps[id = $state.selected]; $state.selected != null and ($state.selected_store in $data.catalog.stores.server or $state.selected_store in $apps.origin.store_url) and $data_meta.detail.state = 'ready' and $exists($a) and $a.origin != null and $a.builtin = false and $a.origin.store_url = $state.selected_store and $a.origin.store_app_id = $state.selected and $not($a.modified) )"},
            "child": {
              "type": "toolbar",
              "start": [
                {
                  "type": "button",
                  "label": "지우기",
                  "variant": "danger",
                  "confirm": {"title": "앱을 지울까요?", "body": {"state": "selected_name"}, "ok": "지우기"},
                  "on_click": [{"store.remove": {"permission": "catalog", "id": {"state": "selected"}}}]
                }
              ],
              "end": [
                {
                  "type": "button",
                  "variant": {"expr": "( $a := $apps[id = $state.selected]; $d := $data.detail; $d.compatible and $a.origin.release < $d.release ? 'primary' : 'default' )"},
                  "label": {"expr": "( $a := $apps[id = $state.selected]; $a.origin.release < $data.detail.release ? '업데이트' : '설치됨' )"},
                  "disabled": {"expr": "( $a := $apps[id = $state.selected]; $d := $data.detail; $not($d.compatible) or $a.origin.release >= $d.release )"},
                  "on_click": [
                    {
                      "store.install": {"permission": "catalog", "server": {"expr": "$data.detail.server"}, "id": {"state": "selected"}, "release": {"expr": "$data.detail.release"}}
                    }
                  ]
                }
              ]
            }
          },
          {
            "type": "when",
            "value": {"expr": "( $id := $state.selected; $a := $apps[id = $id]; $listed := $state.selected_store != null and $count($data.catalog.stores[server = $state.selected_store and $count(items[id = $id]) > 0]) > 0; $id != null and $listed and ($state.selected_store in $data.catalog.stores.server or $state.selected_store in $apps.origin.store_url) and $data_meta.detail.state = 'ready' and $exists($a) and $a.origin != null and $a.builtin = false and ($a.origin.store_url != $state.selected_store or $a.origin.store_app_id != $id or $a.modified) )"},
            "child": {
              "type": "toolbar",
              "start": [
                {
                  "type": "button",
                  "label": "지우기",
                  "variant": "danger",
                  "confirm": {"title": "앱을 지울까요?", "body": {"state": "selected_name"}, "ok": "지우기"},
                  "on_click": [{"store.remove": {"permission": "catalog", "id": {"state": "selected"}}}]
                }
              ],
              "end": [
                {
                  "type": "button",
                  "variant": {"expr": "( $a := $apps[id = $state.selected]; $d := $data.detail; $data_meta.detail.state = 'ready' and $d.compatible and $not($exists($a) and $a.origin != null and $a.origin.store_url = $state.selected_store and $a.origin.store_app_id = $state.selected and $a.origin.release > $d.release) ? 'primary' : 'default' )"},
                  "label": {"expr": "( $a := $apps[id = $state.selected]; $exists($a) and $a.origin != null and $a.origin.store_url = $state.selected_store and $a.origin.store_app_id = $state.selected and $a.modified ? '스토어 판으로 되돌리기' : '스토어 판으로 바꾸기' )"},
                  "disabled": {"expr": "( $a := $apps[id = $state.selected]; $d := $data.detail; $not($data_meta.detail.state = 'ready' and $d.compatible) or ($exists($a) and $a.origin != null and $a.origin.store_url = $state.selected_store and $a.origin.store_app_id = $state.selected and $a.origin.release > $d.release) )"},
                  "on_click": [
                    {
                      "store.install": {"permission": "catalog", "server": {"expr": "$data.detail.server"}, "id": {"state": "selected"}, "release": {"expr": "$data.detail.release"}, "replace": true}
                    }
                  ]
                }
              ]
            }
          },
          {
            "type": "when",
            "value": {"expr": "$state.selected != null and ($state.selected_store in $data.catalog.stores.server or $state.selected_store in $apps.origin.store_url) and $data_meta.detail.state != 'ready' and $count($apps[id = $state.selected and origin != null]) > 0"},
            "child": {
              "type": "toolbar",
              "start": [
                {
                  "type": "button",
                  "label": "지우기",
