{
  "id": "store",
  "name": "앱스토어",
  "description": "스토어의 앱을 찾아 설치하고, 설치한 앱을 업데이트하거나 지웁니다",
  "requires": {"blocks": 43, "modules": {"store": 3, "storage": 2, "assets": 1, "shell": 1}},
  "badge": {"expr": "$count($apps[origin != null and $not(modified) and latest.compatible = true and latest.release > origin.release])"},
  "icon": {"asset": "builtin-icon-store", "version": 2},
  "assets": [{"id": "builtin-icon-store", "version": 2}],
  "permissions": [{"module": "store", "id": "catalog", "label": "앱 설치"}],
  "storage": {
    "entries": [
      {
        "id": "store",
        "key": "settings/store",
        "kind": "json",
        "label": "스토어",
        "presentation": "hidden",
        "description": "앱 목록을 읽어 올 곳",
        "schema": {"type": "string", "enum": ["default", "custom"]},
        "default": "default"
      },
      {
        "id": "custom_url",
        "key": "settings/custom-url",
        "kind": "json",
        "label": "직접 입력 주소",
        "presentation": "hidden",
        "description": "직접 입력을 골랐을 때 읽을 https 주소",
        "schema": {"type": "string"},
        "default": ""
      },
      {
        "id": "servers",
        "key": "settings/servers",
        "kind": "json",
        "label": "사설 스토어",
        "presentation": "hidden",
        "schema": {"type": ["array", "null"], "items": {"type": "string"}},
        "default": null
      }
    ]
  },
  "state": {"category": "", "query": "", "selected": null, "selected_name": "", "selected_store": null, "new_server": "", "new_invite": "", "selected_key": null, "shortcut_added": null},
  "sources": {
    "catalog": {
      "kind": "store",
      "store": "indexes",
      "permission": "catalog",
      "servers": {"expr": "$append(['https://kaleidoscope.eiaserinnys.me/appstore'], ($type($storage.servers) = 'array' ? $storage.servers : ($trim($storage.custom_url) != '' ? [$trim($storage.custom_url)] : [])))"}
    },
    "detail": {
      "kind": "store",
      "store": "app",
      "permission": "catalog",
      "server": {"state": "selected_store"},
      "id": {"expr": "$state.selected != null and ($state.selected_store in $data.catalog.stores.server or $state.selected_store in $apps.origin.store_url) ? $state.selected : null"}
    }
  },
  "window_title": {"title": "앱스토어"},
  "ui": {
    "type": "split",
    "direction": "row",
    "sizes": [18, 47, 35],
    "column_below": 640,
    "children": [
      {
        "type": "stack",
        "direction": "column",
        "gap": "none",
        "fill": 1,
        "children": [
          {"type": "toolbar", "start": [{"type": "text", "value": "카테고리", "format": "plain", "style": "title"}]},
          {
            "type": "list",
            "layout": "rows",
            "items": {"expr": "(\n  $all := [$data.catalog.stores[state = 'ready'].items];\n  $installed := $apps[origin != null];\n  $updates := $installed[$not(modified) and latest.compatible = true and latest.release > origin.release];\n  $cats := $sort($distinct($all.category));\n  $append($append([{ \"key\": \"\", \"title\": \"전체\", \"meta\": $string($count($all)) }],\n    [$cats.( $c := $; { \"key\": $c, \"title\": $c, \"meta\": $string($count($all[category = $c])) } )]),\n    [{ \"key\": \"__updates\", \"title\": \"업데이트\", \"meta\": $string($count($updates)) },\n     { \"key\": \"__installed\", \"title\": \"설치됨\", \"meta\": $string($count($installed)) }])\n)"},
            "selected": {"state": "category"},
            "on_select": [{"set_state": "category"}]
          }
        ]
      },
      {
        "type": "stack",
        "direction": "column",
        "gap": "none",
        "fill": 1,
        "children": [
          {
            "type": "toolbar",
            "start": [{"type": "input", "kind": "search", "value": {"state": "query"}, "on_change": {"set_state": "query"}, "placeholder": "앱 이름이나 id로 찾기"}],
            "end": [{"type": "button", "label": "다시 받기", "icon": "refresh-cw", "icon_only": true, "variant": "ghost", "on_click": [{"refresh": ["catalog", "detail"]}]}]
          },
          {
            "type": "list",
            "layout": "icons",
            "items": {"expr": "(\n  $q := $lowercase($trim($state.query)); $category := $state.category;\n  $stores := [$data.catalog.stores];\n  $ready := [$stores[state = 'ready']];\n  $all := [$ready.items];\n  $first := $ready[0].server;\n  $installedAll := [$apps[origin != null]];\n  $updatesAll := [$installedAll[$not(modified) and latest.compatible = true and latest.release > origin.release]];\n  $chosenAll := $category = '__updates' ? $updatesAll : $installedAll;\n  $storeGroups := [$map($stores, function($s, $index) { (\n    $installed := [$installedAll[origin.store_url = $s.server]];\n    $updates := [$updatesAll[origin.store_url = $s.server]];\n    $chosen := $category = '__updates' ? $updates : $installed;\n    $pool := $category = '__installed' or $category = '__updates'\n      ? $append([$s.items[id in $chosen.id]], [$chosen[$not(id in $s.items.id)].{ \"id\": id, \"name\": name }])\n      : ($category = '' ? $s.items : [$s.items[category = $category]]);\n    $hits := [$pool[$q = '' or $contains($lowercase(name), $q) or $contains($lowercase(id), $q) or $contains($lowercase($string(summary)), $q)]];\n    $direct := $s.state = 'ready' and $s.server = $first and $category != '__updates' and $category != '__installed' and $q != '' and $not($q in $all.id) and $match($q, /^[a-z0-9-]{1,64}$/)\n      ? [{ \"id\": $q, \"name\": $q }] : [];\n    $items := [$map($append($hits, $direct), function($a) { { \"key\": $string([$s.server, $a.id]), \"title\": $a.name, \"image\": $a.icon, \"server\": $s.server, \"id\": $a.id } })];\n    $group := { \"key\": $s.server, \"server\": $s.server, \"title\": $index = 0 ? '기본 앱스토어' : '사설 ' & $string($index), \"items\": $items };\n    $merge([$group, $index = 0 ? {} : { \"meta\": $s.server },\n      $s.state = 'ready' ? ($count($items) = 0 ? { \"status\": { \"state\": \"empty\" } } : {})\n      : $s.state = 'permission_required' ? { \"status\": { \"state\": \"empty\", \"message\": \"이 PC에서 연결을 허용하면 앱을 볼 수 있습니다.\" }, \"action\": \"allow\" }\n      : $merge([{ \"status\": { \"state\": \"error\", \"message\": $s.error.message, \"code\": $s.error.id } },\n          $s.error.id = 'STORECLIENT_URL_COMPONENT_INVALID' ? {} : { \"action\": \"retry\" }])])\n  ) })];\n  $orphans := [$chosenAll[$not(origin.store_url in $stores.server) and ($q = '' or $contains($lowercase(name), $q) or $contains($lowercase(id), $q))]];\n  $other := ($category = '__installed' or $category = '__updates') and $count($orphans) > 0\n    ? [{ \"key\": \"other-stores\", \"title\": \"그 밖의 스토어\", \"items\": [$map($orphans, function($a) { { \"key\": $string([$a.origin.store_url, $a.id]), \"title\": $a.name, \"server\": $a.origin.store_url, \"id\": $a.id } })] }] : [];\n  $append($storeGroups, $other)\n)"},
            "selected": {"state": "selected_key"},
            "on_select": [
              {"set_state": "selected_key", "value": {"expr": "$item.key"}},
              {"set_state": "selected", "value": {"expr": "$item.id"}},
              {"set_state": "selected_store", "value": {"expr": "$item.server"}},
              {"set_state": "selected_name", "value": {"expr": "$item.title"}}
            ],
            "grouped": true,
            "group_actions": [
              {"key": "allow", "label": "연결 허용", "on_click": [{"store.allow_server": {"permission": "catalog", "server": {"expr": "$item.server"}}}]},
              {"key": "retry", "label": "다시 받기", "on_click": [{"refresh": ["catalog", "detail"]}]}
            ]
          }
        ]
      },
      {
        "type": "stack",
        "direction": "column",
        "gap": "none",
        "fill": [1, 2],
        "children": [
          {
            "type": "toolbar",
            "start": [
              {
                "type": "text",
                "value": {"expr": "$state.selected != null and ($state.selected_store in $data.catalog.stores.server or $state.selected_store in $apps.origin.store_url) ? $state.selected_name : ''"},
                "format": "plain",
                "style": "title"
              }
            ]
          },
          {
            "type": "when",
            "value": {"expr": "$state.selected != null and ($state.selected_store in $data.catalog.stores.server or $state.selected_store in $apps.origin.store_url) and $data_meta.detail.state = 'ready'"},
            "child": {
              "type": "stack",
              "direction": "column",
              "gap": "medium",
              "children": [
                {
                  "type": "properties",
                  "fields": [
                    {"label": "제작자", "value": {"expr": "$data.detail.publisher"}, "format": "text"},
                    {"label": "분류", "value": {"expr": "$data.detail.category"}, "format": "text"},
                    {"label": "판", "value": {"expr": "$string($data.detail.release)"}, "format": "text"},
                    {"label": "올린 날", "value": {"expr": "$fromMillis($toMillis($data.detail.releases[release = $data.detail.release].published_at), '[Y0001]년 [M1]월 [D1]일', '+0900')"}, "format": "text"},
                    {
                      "label": "권한",
                      "value": {"expr": "( $d := $data.detail; $p := [$d.permissions.{ \"text\": label ? label : module, \"color\": module = 'process' ? '#a9363d' : '#6b7280' }]; $b := [$d.badges[$ = 'worker'].{ \"text\": \"서버 실행 코드\", \"color\": \"#a9363d\" }]; $all := $append($p, $b); $count($all) = 0 ? null : $all )"},
                      "format": "badge"
                    },
                    {"label": "권한", "value": {"expr": "$count($data.detail.permissions) + $count($data.detail.badges[$ = 'worker']) = 0 ? '없음' : null"}, "format": "text"},
                    {
                      "label": "요구 쉘",
                      "value": {"expr": "$data.detail.compatible ? null : '블록 세트 ' & $string($data.detail.requires.blocks) & ', 쉘을 올려야 설치합니다'"},
                      "format": "text"
                    },
                    {
                      "label": "상태",
                      "value": {"expr": "(\n  $a := $apps[id = $state.selected]; $d := $data.detail;\n  $names := [$map($data.catalog.stores, function($s, $i) { $s.server = $a.origin.store_url ? ($i = 0 ? '기본 앱스토어' : '사설 ' & $string($i)) : null })][$ != null];\n  $not($exists($a)) ? '설치 전' : ($a.origin = null ? '같은 id의 다른 앱이 있어 설치할 수 없습니다' :\n    ($a.origin.store_url != $state.selected_store ? ($count($names) > 0 ? $names[0] : '다른 스토어') & '에서 설치한 앱입니다. 지운 뒤 설치할 수 있습니다.' :\n      ($a.modified ? '설치 뒤 고친 앱이라 업데이트하지 않습니다' : ($a.origin.release < $d.release ? $string($a.origin.release) & '판 설치됨, 새 판 있음' : $string($a.origin.release) & '판 설치됨'))))\n)"},
                      "format": "text"
                    },
                    {"label": "id", "value": {"state": "selected"}, "format": "code"}
                  ]
                },
                {
                  "type": "when",
                  "value": {"expr": "$count($data.detail.screenshots) > 0"},
                  "child": {
                    "type": "list",
                    "layout": "grid",
                    "items": {"expr": "[$map($data.detail.screenshots, function($s, $i) { { \"key\": $string($i), \"title\": '', \"image\": $s } })]"}
                  }
                },
                {"type": "text", "value": {"expr": "$data.detail.description"}, "format": "markdown", "style": "body"}
              ]
            }
          },
          {
            "type": "when",
            "value": {"expr": "$state.selected != null and ($state.selected_store in $data.catalog.stores.server or $state.selected_store in $apps.origin.store_url) and $data_meta.detail.state != 'ready'"},
            "child": {"type": "text", "value": {"expr": "$data.detail.name"}}
          },
          {
            "type": "when",
            "value": {"expr": "$state.selected != null and $count($apps[id = $state.selected]) > 0"},
            "child": {
              "type": "toolbar",
              "start": [],
              "end": [
                {
                  "type": "button",
                  "label": {"expr": "$state.shortcut_added = $state.selected ? '바탕화면에 있음' : '바탕화면에 추가'"},
                  "disabled": {"expr": "$state.shortcut_added = $state.selected"},
                  "on_click": [
                    {"shell.add_shortcut": {"app_id": {"state": "selected"}}},
                    {"set_state": "shortcut_added", "value": {"state": "selected"}}
                  ]
                },
                {
                  "type": "button",
                  "variant": "primary",
                  "label": "열기",
                  "on_click": [{"shell.open": {"app_id": {"state": "selected"}}}]
                }
              ]
            }
          },
          {
            "type": "when",
            "value": {"expr": "$state.selected != null and ($state.selected_store in $data.catalog.stores.server or $state.selected_store in $apps.origin.store_url) and $data_meta.detail.state = 'ready' and $count($apps[id = $state.selected and origin != null]) > 0"},
            "child": {
              "type": "toolbar",
              "start": [
                {
                  "type": "button",
                  "label": "지우기",
                  "variant": "danger",
                  "confirm": {"title": "앱을 지울까요?", "body": {"state": "selected_name"}, "ok": "지우기"},
                  "on_click": [{"store.remove": {"permission": "catalog", "id": {"state": "selected"}}}]
                }
              ],
              "end": [
                {
                  "type": "button",
                  "variant": "primary",
                  "label": {"expr": "( $a := $apps[id = $state.selected]; $exists($a) and $a.origin != null and $a.origin.store_url = $state.selected_store and $a.origin.release < $data.detail.release ? '업데이트' : ($exists($a) ? '설치됨' : '설치') )"},
                  "disabled": {"expr": "( $a := $apps[id = $state.selected]; $d := $data.detail; $not($d.compatible) or ($exists($a) and ($a.origin = null or $a.origin.store_url != $state.selected_store or $a.modified or $a.origin.release >= $d.release)) )"},
                  "on_click": [
                    {
                      "store.install": {"permission": "catalog", "server": {"expr": "$data.detail.server"}, "id": {"state": "selected"}, "release": {"expr": "$data.detail.release"}}
                    }
                  ]
                }
              ]
            }
          },
          {
            "type": "when",
            "value": {"expr": "$state.selected != null and ($state.selected_store in $data.catalog.stores.server or $state.selected_store in $apps.origin.store_url) and $data_meta.detail.state != 'ready' and $count($apps[id = $state.selected and origin != null]) > 0"},
            "child": {
              "type": "toolbar",
              "start": [
                {
                  "type": "button",
                  "label": "지우기",
                  "variant": "danger",
                  "confirm": {"title": "앱을 지울까요?", "body": {"state": "selected_name"}, "ok": "지우기"},
                  "on_click": [{"store.remove": {"permission": "catalog", "id": {"state": "selected"}}}]
                }
              ],
              "end": [
                {
                  "type": "button",
                  "label": {"expr": "( $a := $apps[id = $state.selected]; $exists($a[origin != null and origin.store_url = $state.selected_store and $not(modified) and latest.compatible = true and latest.release > origin.release]) ? '업데이트' : ($exists($a) ? '설치됨' : '설치') )"},
                  "variant": "primary",
                  "disabled": true,
                  "on_click": [{"set_state": "selected", "value": {"state": "selected"}}]
                }
              ]
            }
          },
          {
            "type": "when",
            "value": {"expr": "$state.selected != null and ($state.selected_store in $data.catalog.stores.server or $state.selected_store in $apps.origin.store_url) and $data_meta.detail.state = 'ready' and $count($apps[id = $state.selected and origin != null]) = 0"},
            "child": {
              "type": "toolbar",
              "start": [],
              "end": [
                {
                  "type": "button",
                  "variant": "primary",
                  "label": {"expr": "( $a := $apps[id = $state.selected]; $exists($a) and $a.origin != null and $a.origin.store_url = $state.selected_store and $a.origin.release < $data.detail.release ? '업데이트' : ($exists($a) ? '설치됨' : '설치') )"},
                  "disabled": {"expr": "( $a := $apps[id = $state.selected]; $d := $data.detail; $not($d.compatible) or ($exists($a) and ($a.origin = null or $a.origin.store_url != $state.selected_store or $a.modified or $a.origin.release >= $d.release)) )"},
                  "on_click": [
                    {
                      "store.install": {"permission": "catalog", "server": {"expr": "$data.detail.server"}, "id": {"state": "selected"}, "release": {"expr": "$data.detail.release"}}
                    }
                  ]
                }
              ]
            }
          },
          {
            "type": "when",
            "value": {"expr": "$state.selected != null and ($state.selected_store in $data.catalog.stores.server or $state.selected_store in $apps.origin.store_url) and $data_meta.detail.state != 'ready' and $count($apps[id = $state.selected and origin != null]) = 0"},
            "child": {
              "type": "toolbar",
              "start": [],
              "end": [
                {
                  "type": "button",
                  "label": {"expr": "( $a := $apps[id = $state.selected]; $exists($a[origin != null and origin.store_url = $state.selected_store and $not(modified) and latest.compatible = true and latest.release > origin.release]) ? '업데이트' : ($exists($a) ? '설치됨' : '설치') )"},
                  "variant": "primary",
                  "disabled": true,
                  "on_click": [{"set_state": "selected", "value": {"state": "selected"}}]
                }
              ]
            }
          }
        ]
      }
    ]
  },
  "settings": {
    "ui": {
      "type": "stack",
      "direction": "column",
      "gap": "large",
      "children": [
        {"type": "properties", "fields": [{"label": "기본 앱스토어", "value": "https://kaleidoscope.eiaserinnys.me/appstore", "format": "text"}]},
        {
          "type": "list",
          "layout": "rows",
          "items": {"expr": "[$map(($type($storage.servers) = 'array' ? $storage.servers : ($trim($storage.custom_url) != '' ? [$trim($storage.custom_url)] : [])), function($server, $index) { {\"key\": $server, \"title\": $server, \"meta\": \"사설 \" & $string($index + 1)} })]"},
          "on_remove": [
            {
              "set_storage": {
                "entry": "servers",
                "value": {"expr": "[($type($storage.servers) = 'array' ? $storage.servers : ($trim($storage.custom_url) != '' ? [$trim($storage.custom_url)] : []))[$ != $item.key]]"}
              }
            }
          ]
        },
        {
          "type": "stack",
          "direction": "column",
          "gap": "small",
          "children": [
            {
              "type": "input",
              "label": "사설 스토어 주소",
              "value": {"state": "new_server"},
              "on_change": {"set_state": "new_server"},
              "on_submit": [
                {
                  "set_storage": {
                    "entry": "servers",
                    "value": {"expr": "($url := $replace($trim($state.new_server), /\\/+$/, '') & ($trim($state.new_invite) = '' ? '' : '/' & $encodeUrlComponent($lowercase($trim($state.new_invite)))); $not($contains($url, /^https?:\\/\\//)) or $url in [($type($storage.servers) = 'array' ? $storage.servers : ($trim($storage.custom_url) != '' ? [$trim($storage.custom_url)] : [])).$replace($, /\\/+$/, '')] or $url = 'https://kaleidoscope.eiaserinnys.me/appstore' ? ($type($storage.servers) = 'array' ? $storage.servers : ($trim($storage.custom_url) != '' ? [$trim($storage.custom_url)] : [])) : $append(($type($storage.servers) = 'array' ? $storage.servers : ($trim($storage.custom_url) != '' ? [$trim($storage.custom_url)] : [])), [$url]))"}
                  }
                },
                {"set_state": "new_invite", "value": {"expr": "$contains($trim($state.new_server), /^https?:\\/\\//) ? '' : $state.new_invite"}},
                {"set_state": "new_server", "value": {"expr": "$contains($trim($state.new_server), /^https?:\\/\\//) ? '' : $state.new_server"}}
              ]
            },
            {
              "type": "input",
              "label": "초대코드",
              "value": {"state": "new_invite"},
              "on_change": {"set_state": "new_invite"},
              "placeholder": "받은 초대코드가 있으면 넣습니다",
              "on_submit": [
                {
                  "set_storage": {
                    "entry": "servers",
                    "value": {"expr": "($url := $replace($trim($state.new_server), /\\/+$/, '') & ($trim($state.new_invite) = '' ? '' : '/' & $encodeUrlComponent($lowercase($trim($state.new_invite)))); $not($contains($url, /^https?:\\/\\//)) or $url in [($type($storage.servers) = 'array' ? $storage.servers : ($trim($storage.custom_url) != '' ? [$trim($storage.custom_url)] : [])).$replace($, /\\/+$/, '')] or $url = 'https://kaleidoscope.eiaserinnys.me/appstore' ? ($type($storage.servers) = 'array' ? $storage.servers : ($trim($storage.custom_url) != '' ? [$trim($storage.custom_url)] : [])) : $append(($type($storage.servers) = 'array' ? $storage.servers : ($trim($storage.custom_url) != '' ? [$trim($storage.custom_url)] : [])), [$url]))"}
                  }
                },
                {"set_state": "new_invite", "value": {"expr": "$contains($trim($state.new_server), /^https?:\\/\\//) ? '' : $state.new_invite"}},
                {"set_state": "new_server", "value": {"expr": "$contains($trim($state.new_server), /^https?:\\/\\//) ? '' : $state.new_server"}}
              ]
            },
            {
              "type": "stack",
              "direction": "column",
              "align": "end",
              "children": [
                {
                  "type": "button",
                  "label": "추가",
                  "disabled": {"expr": "($url := $replace($trim($state.new_server), /\\/+$/, '') & ($trim($state.new_invite) = '' ? '' : '/' & $encodeUrlComponent($lowercase($trim($state.new_invite)))); $not($contains($url, /^https?:\\/\\//)) or $url in [($type($storage.servers) = 'array' ? $storage.servers : ($trim($storage.custom_url) != '' ? [$trim($storage.custom_url)] : [])).$replace($, /\\/+$/, '')] or $url = 'https://kaleidoscope.eiaserinnys.me/appstore')"},
                  "on_click": [
                    {
                      "set_storage": {
                        "entry": "servers",
                        "value": {"expr": "($url := $replace($trim($state.new_server), /\\/+$/, '') & ($trim($state.new_invite) = '' ? '' : '/' & $encodeUrlComponent($lowercase($trim($state.new_invite)))); $not($contains($url, /^https?:\\/\\//)) or $url in [($type($storage.servers) = 'array' ? $storage.servers : ($trim($storage.custom_url) != '' ? [$trim($storage.custom_url)] : [])).$replace($, /\\/+$/, '')] or $url = 'https://kaleidoscope.eiaserinnys.me/appstore' ? ($type($storage.servers) = 'array' ? $storage.servers : ($trim($storage.custom_url) != '' ? [$trim($storage.custom_url)] : [])) : $append(($type($storage.servers) = 'array' ? $storage.servers : ($trim($storage.custom_url) != '' ? [$trim($storage.custom_url)] : [])), [$url]))"}
                      }
                    },
                    {"set_state": "new_invite", "value": {"expr": "$contains($trim($state.new_server), /^https?:\\/\\//) ? '' : $state.new_invite"}},
                    {"set_state": "new_server", "value": {"expr": "$contains($trim($state.new_server), /^https?:\\/\\//) ? '' : $state.new_server"}}
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
