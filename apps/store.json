              ]
            }
          },
          {
            "type": "when",
            "value": {"expr": "(\n  $id := $state.selected;\n  $custom := $id != null and $state.selected_store = null and $count($apps[id = $id and builtin = false and origin = null]) > 0;\n  $custom and $count([$lookup($data, 'catalog').stores[state = 'ready' and $count(items[id = $id]) > 0]]) = 0\n)"},
            "child": {
              "type": "stack",
              "direction": "column",
              "gap": "small",
              "children": [
                {
                  "type": "when",
                  "value": {"expr": "$data_meta.convert.state = 'failed' or $data_meta.convert.state = 'loading'"},
                  "child": {"type": "text", "value": {"expr": "$data.convert.name"}}
                },
                {
                  "type": "toolbar",
                  "start": [
                    {
                      "type": "button",
                      "label": "지우기",
                      "variant": "danger",
                      "confirm": {"title": "앱을 지울까요?", "body": {"state": "selected_name"}, "ok": "지우기"},
                      "on_click": [
                        {"store.remove": {"permission": "catalog", "id": {"state": "selected"}, "allow_custom": true}},
                        {"set_state": "selected", "value": null},
                        {"set_state": "selected_name", "value": ""},
                        {"set_state": "selected_store", "value": null},
                        {"set_state": "selected_key", "value": null},
                        {"set_state": "custom_store", "value": null}
                      ]
                    }
                  ],
                  "end": []
                }
              ]
            }
          }
        ]
      }
    ]
  },
  "settings": {
    "ui": {
      "type": "stack",
      "direction": "column",
      "gap": "large",
      "children": [
        {"type": "properties", "fields": [{"label": "기본 앱스토어", "value": "https://kaleidoscope.eiaserinnys.me/appstore", "format": "text"}]},
        {
          "type": "list",
          "layout": "rows",
          "items": {"expr": "[$map(($type($storage.servers) = 'array' ? $storage.servers : ($trim($storage.custom_url) != '' ? [$trim($storage.custom_url)] : [])), function($server, $index) { {\"key\": $server, \"title\": $server, \"meta\": \"사설 \" & $string($index + 1)} })]"},
          "on_remove": [
            {
              "set_storage": {
                "entry": "servers",
                "value": {"expr": "[($type($storage.servers) = 'array' ? $storage.servers : ($trim($storage.custom_url) != '' ? [$trim($storage.custom_url)] : []))[$ != $item.key]]"}
              }
            },
            {
              "set_storage": {
                "entry": "invites",
                "value": {"expr": "($codes := ($type($storage.invites) = 'object' ? $storage.invites : {}); $sift($codes, function($v, $k) { $k != $item.key }))"}
              }
            }
          ]
        },
        {
          "type": "stack",
          "direction": "column",
          "gap": "small",
          "children": [
            {
              "type": "input",
              "label": "사설 스토어 주소",
              "value": {"state": "new_server"},
              "on_change": {"set_state": "new_server"},
              "on_submit": [
                {
                  "set_storage": {
                    "entry": "invites",
                    "value": {"expr": "($url := $replace($trim($state.new_server), /\\/+$/, ''); $codes := ($type($storage.invites) = 'object' ? $storage.invites : {}); $not($contains($url, /^https?:\\/\\//)) or $url = 'https://kaleidoscope.eiaserinnys.me/appstore' or $trim($state.new_invite) = '' ? $codes : $merge([$codes, { $url: $lowercase($trim($state.new_invite)) }]))"}
                  }
                },
                {
                  "set_storage": {
                    "entry": "servers",
                    "value": {"expr": "($url := $replace($trim($state.new_server), /\\/+$/, ''); $stores := ($type($storage.servers) = 'array' ? $storage.servers : ($trim($storage.custom_url) != '' ? [$trim($storage.custom_url)] : [])); $not($contains($url, /^https?:\\/\\//)) or $url = 'https://kaleidoscope.eiaserinnys.me/appstore' or $url in [$stores.$replace($, /\\/+$/, '')] ? $stores : $append($stores, [$url]))"}
                  }
                },
                {"set_state": "new_invite", "value": {"expr": "$contains($trim($state.new_server), /^https?:\\/\\//) ? '' : $state.new_invite"}},
                {"set_state": "new_server", "value": {"expr": "$contains($trim($state.new_server), /^https?:\\/\\//) ? '' : $state.new_server"}}
              ]
            },
            {
              "type": "input",
              "label": "초대코드",
              "value": {"state": "new_invite"},
              "on_change": {"set_state": "new_invite"},
              "placeholder": "받은 초대코드가 있으면 넣습니다",
              "on_submit": [
                {
                  "set_storage": {
                    "entry": "invites",
                    "value": {"expr": "($url := $replace($trim($state.new_server), /\\/+$/, ''); $codes := ($type($storage.invites) = 'object' ? $storage.invites : {}); $not($contains($url, /^https?:\\/\\//)) or $url = 'https://kaleidoscope.eiaserinnys.me/appstore' or $trim($state.new_invite) = '' ? $codes : $merge([$codes, { $url: $lowercase($trim($state.new_invite)) }]))"}
                  }
                },
                {
                  "set_storage": {
