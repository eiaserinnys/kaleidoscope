{
  "id": "store",
  "name": "앱스토어",
  "description": "스토어의 앱을 찾아 설치하고, 설치한 앱을 업데이트하거나 지웁니다",
  "requires": {"blocks": 43, "modules": {"store": 3, "storage": 2, "assets": 1}},
  "badge": {"expr": "$count($apps[origin != null and $not(modified) and latest.compatible = true and latest.release > origin.release])"},
  "icon": {"asset": "builtin-icon-store", "version": 2},
  "assets": [{"id": "builtin-icon-store", "version": 2}],
  "permissions": [{"module": "store", "id": "catalog", "label": "앱 설치"}],
  "storage": {
    "entries": [
      {
        "id": "store",
        "key": "settings/store",
        "kind": "json",
        "label": "스토어",
        "presentation": "hidden",
        "description": "앱 목록을 읽어 올 곳",
        "schema": {"type": "string", "enum": ["default", "custom"]},
        "default": "default"
      },
      {
        "id": "custom_url",
        "key": "settings/custom-url",
        "kind": "json",
        "label": "직접 입력 주소",
        "presentation": "hidden",
        "description": "직접 입력을 골랐을 때 읽을 https 주소",
        "schema": {"type": "string"},
        "default": ""
      },
      {
        "id": "servers",
        "key": "settings/servers",
        "kind": "json",
        "label": "사설 스토어",
        "presentation": "hidden",
        "schema": {"type": ["array", "null"], "items": {"type": "string"}},
        "default": null
      }
    ]
  },
  "state": {"category": "", "query": "", "selected": null, "selected_name": "", "selected_store": null, "new_server": "", "selected_key": null},
  "sources": {
    "catalog": {
      "kind": "store",
      "store": "indexes",
      "permission": "catalog",
      "servers": {"expr": "$append(['https://kaleidoscope.eiaserinnys.me/appstore'], ($type($storage.servers) = 'array' ? $storage.servers : ($trim($storage.custom_url) != '' ? [$trim($storage.custom_url)] : [])))"}
    },
    "detail": {
      "kind": "store",
      "store": "app",
      "permission": "catalog",
      "server": {"state": "selected_store"},
      "id": {"expr": "$state.selected != null and $state.selected_store in $data.catalog.stores.server ? $state.selected : null"}
    }
  },
  "window_title": {"title": "앱스토어"},
  "ui": {
    "type": "split",
    "direction": "row",
    "sizes": [18, 47, 35],
    "column_below": 640,
    "children": [
      {
        "type": "stack",
        "direction": "column",
        "gap": "none",
        "fill": 1,
        "children": [
          {"type": "toolbar", "start": [{"type": "text", "value": "카테고리", "format": "plain", "style": "title"}]},
          {
            "type": "list",
            "layout": "rows",
            "items": {"expr": "(\n  $all := [$data.catalog.stores[state = 'ready'].items];\n  $installed := $apps[origin != null];\n  $updates := $installed[$not(modified) and latest.compatible = true and latest.release > origin.release];\n  $cats := $sort($distinct($all.category));\n  $append($append([{ \"key\": \"\", \"title\": \"전체\", \"meta\": $string($count($all)) }],\n    [$cats.( $c := $; { \"key\": $c, \"title\": $c, \"meta\": $string($count($all[category = $c])) } )]),\n    [{ \"key\": \"__updates\", \"title\": \"업데이트\", \"meta\": $string($count($updates)) },\n     { \"key\": \"__installed\", \"title\": \"설치됨\", \"meta\": $string($count($installed)) }])\n)"},
            "selected": {"state": "category"},
            "on_select": [{"set_state": "category"}]
          }
        ]
      },
      {
        "type": "stack",
        "direction": "column",
        "gap": "none",
        "fill": 1,
        "children": [
          {
            "type": "toolbar",
            "start": [{"type": "input", "kind": "search", "value": {"state": "query"}, "on_change": {"set_state": "query"}, "placeholder": "앱 이름이나 id로 찾기"}],
            "end": [{"type": "button", "label": "다시 받기", "icon": "refresh-cw", "icon_only": true, "variant": "ghost", "on_click": [{"refresh": ["catalog", "detail"]}]}]
          },
          {
            "type": "list",
            "layout": "icons",
            "items": {"expr": "(\n  $q := $lowercase($trim($state.query)); $category := $state.category;\n  [$map($data.catalog.stores, function($s, $index) { (\n    $installed := [$apps[origin != null and origin.store_url = $s.server]];\n    $updates := [$installed[$not(modified) and latest.compatible = true and latest.release > origin.release]];\n    $chosen := $category = '__updates' ? $updates : $installed;\n    $pool := $category = '__installed' or $category = '__updates'\n      ? $append([$s.items[id in $chosen.id]], [$chosen[$not(id in $s.items.id)].{ \"id\": id, \"name\": name }])\n      : ($category = '' ? $s.items : [$s.items[category = $category]]);\n    $hits := [$pool[$q = '' or $contains($lowercase(name), $q) or $contains($lowercase(id), $q) or $contains($lowercase($string(summary)), $q)]];\n    $direct := $s.state = 'ready' and $category != '__updates' and $category != '__installed' and $q != '' and $not($q in $s.items.id) and $match($q, /^[a-z0-9-]{1,64}$/)\n      ? [{ \"id\": $q, \"name\": $q }] : [];\n    $items := [$map($append($hits, $direct), function($a) { { \"key\": $string([$s.server, $a.id]), \"title\": $a.name, \"image\": $a.icon, \"server\": $s.server, \"id\": $a.id } })];\n    $group := { \"key\": $s.server, \"server\": $s.server, \"title\": $index = 0 ? '기본 앱스토어' : '사설 ' & $string($index), \"items\": $items };\n    $merge([$group, $s.state = 'ready' ? ($count($items) = 0 ? { \"status\": { \"state\": \"empty\" } } : {})\n      : { \"status\": { \"state\": \"error\", \"message\": $s.error.message, \"code\": $s.error.id }, \"action\": $s.state = 'permission_required' ? 'allow' : 'retry' }])\n  ) })]\n)"},
            "selected": {"state": "selected_key"},
            "on_select": [
              {"set_state": "selected_key", "value": {"expr": "$item.key"}},
              {"set_state": "selected", "value": {"expr": "$item.id"}},
              {"set_state": "selected_store", "value": {"expr": "$item.server"}},
              {"set_state": "selected_name", "value": {"expr": "$item.title"}}
            ],
            "grouped": true,
            "group_actions": [
              {"key": "allow", "label": "연결 허용", "on_click": [{"store.allow_server": {"permission": "catalog", "server": {"expr": "$item.server"}}}]},
              {"key": "retry", "label": "다시 받기", "on_click": [{"refresh": ["catalog", "detail"]}]}
            ]
          }
        ]
      },
      {
        "type": "stack",
        "direction": "column",
        "gap": "none",
        "fill": [1, 2],
        "children": [
          {
            "type": "toolbar",
            "start": [
              {
                "type": "text",
                "value": {"expr": "$state.selected != null and $state.selected_store in $data.catalog.stores.server ? $state.selected_name : ''"},
                "format": "plain",
                "style": "title"
              }
            ]
          },
          {
            "type": "when",
            "value": {"expr": "$state.selected != null and $state.selected_store in $data.catalog.stores.server and $data_meta.detail.state = 'ready'"},
            "child": {
              "type": "stack",
              "direction": "column",
              "gap": "medium",
              "children": [
                {
                  "type": "properties",
                  "fields": [
                    {"label": "제작자", "value": {"expr": "$data.detail.publisher"}, "format": "text"},
                    {"label": "분류", "value": {"expr": "$data.detail.category"}, "format": "text"},
                    {"label": "판", "value": {"expr": "$string($data.detail.release)"}, "format": "text"},
                    {"label": "올린 날", "value": {"expr": "$data.detail.releases[release = $data.detail.release].published_at"}, "format": "date"},
                    {
                      "label": "권한",
                      "value": {"expr": "( $d := $data.detail; $p := [$d.permissions.{ \"text\": label ? label : module, \"color\": module = 'process' ? '#a9363d' : '#6b7280' }]; $b := [$d.badges[$ = 'worker'].{ \"text\": \"서버 실행 코드\", \"color\": \"#a9363d\" }]; $all := $append($p, $b); $count($all) = 0 ? [{ \"text\": \"없음\", \"color\": \"#6b7280\" }] : $all )"},
                      "format": "badge"
                    },
                    {
                      "label": "요구 쉘",
                      "value": {"expr": "$data.detail.compatible ? null : '블록 세트 ' & $string($data.detail.requires.blocks) & ', 쉘을 올려야 설치합니다'"},
                      "format": "text"
                    },
                    {
                      "label": "상태",
                      "value": {"expr": "( $a := $apps[id = $state.selected]; $d := $data.detail; $not($exists($a)) ? '설치 전' : ($a.origin = null ? '같은 id의 다른 앱이 있어 설치할 수 없습니다' : ($a.origin.store_url != $state.selected_store ? '다른 스토어에서 설치한 앱입니다. 지운 뒤 이 스토어에서 다시 설치할 수 있습니다.' : ($a.modified ? '설치 뒤 고친 앱이라 업데이트하지 않습니다' : ($a.origin.release < $d.release ? $string($a.origin.release) & '판 설치됨, 새 판 있음' : $string($a.origin.release) & '판 설치됨')))) )"},
                      "format": "text"
                    },
                    {"label": "id", "value": {"state": "selected"}, "format": "code"}
                  ]
                },
                {
                  "type": "when",
                  "value": {"expr": "$count($data.detail.screenshots) > 0"},
                  "child": {
                    "type": "list",
                    "layout": "grid",
                    "items": {"expr": "[$map($data.detail.screenshots, function($s, $i) { { \"key\": $string($i), \"title\": '', \"image\": $s } })]"}
                  }
                },
                {"type": "text", "value": {"expr": "$data.detail.description"}, "format": "markdown", "style": "body"}
              ]
            }
          },
          {
            "type": "when",
            "value": {"expr": "$state.selected != null and $state.selected_store in $data.catalog.stores.server and $data_meta.detail.state != 'ready'"},
            "child": {"type": "text", "value": {"expr": "$data.detail.name"}}
          },
          {
            "type": "when",
            "value": {"expr": "$state.selected != null and $state.selected_store in $data.catalog.stores.server and $data_meta.detail.state = 'ready'"},
            "child": {
              "type": "toolbar",
              "start": [
                {
                  "type": "button",
                  "label": "지우기",
                  "variant": "danger",
                  "disabled": {"expr": "( $a := $apps[id = $state.selected]; $not($exists($a)) or $a.origin = null )"},
                  "confirm": {"title": "앱을 지울까요?", "body": {"state": "selected_name"}, "ok": "지우기"},
                  "on_click": [{"store.remove": {"permission": "catalog", "id": {"state": "selected"}}}]
                }
              ],
              "end": [
                {
                  "type": "button",
                  "variant": "primary",
                  "label": {"expr": "( $a := $apps[id = $state.selected]; $exists($a) and $a.origin != null and $a.origin.store_url = $state.selected_store and $a.origin.release < $data.detail.release ? '업데이트' : ($exists($a) ? '설치됨' : '설치') )"},
                  "disabled": {"expr": "( $a := $apps[id = $state.selected]; $d := $data.detail; $not($d.compatible) or ($exists($a) and ($a.origin = null or $a.origin.store_url != $state.selected_store or $a.modified or $a.origin.release >= $d.release)) )"},
                  "on_click": [
                    {
                      "store.install": {"permission": "catalog", "server": {"expr": "$data.detail.server"}, "id": {"state": "selected"}, "release": {"expr": "$data.detail.release"}}
                    }
                  ]
                }
              ]
            }
          },
          {
            "type": "when",
            "value": {"expr": "$state.selected != null and $state.selected_store in $data.catalog.stores.server and $data_meta.detail.state != 'ready'"},
            "child": {
              "type": "toolbar",
              "start": [
                {
                  "type": "button",
                  "label": "지우기",
                  "variant": "danger",
                  "disabled": {"expr": "( $a := $apps[id = $state.selected]; $not($exists($a)) or $a.origin = null )"},
                  "confirm": {"title": "앱을 지울까요?", "body": {"state": "selected_name"}, "ok": "지우기"},
                  "on_click": [{"store.remove": {"permission": "catalog", "id": {"state": "selected"}}}]
                }
              ],
              "end": [
                {
                  "type": "button",
                  "label": {"expr": "( $a := $apps[id = $state.selected]; $exists($a[origin != null and origin.store_url = $state.selected_store and $not(modified) and latest.compatible = true and latest.release > origin.release]) ? '업데이트' : ($exists($a) ? '설치됨' : '설치') )"},
                  "variant": "primary",
                  "disabled": true,
                  "on_click": [{"set_state": "selected", "value": {"state": "selected"}}]
                }
              ]
            }
          }
        ]
      }
    ]
  },
  "settings": {
    "ui": {
      "type": "stack",
      "direction": "column",
      "gap": "small",
      "children": [
        {"type": "properties", "fields": [{"label": "기본 앱스토어", "value": "https://kaleidoscope.eiaserinnys.me/appstore", "format": "text"}]},
        {
          "type": "list",
          "layout": "rows",
          "items": {"expr": "[($type($storage.servers) = 'array' ? $storage.servers : ($trim($storage.custom_url) != '' ? [$trim($storage.custom_url)] : [])).{\"key\": $, \"title\": $}]"},
          "on_remove": [
            {
              "set_storage": {
                "entry": "servers",
                "value": {"expr": "[($type($storage.servers) = 'array' ? $storage.servers : ($trim($storage.custom_url) != '' ? [$trim($storage.custom_url)] : []))[$ != $item.key]]"}
              }
            }
          ]
        },
        {"type": "input", "label": "사설 스토어 주소", "value": {"state": "new_server"}, "on_change": {"set_state": "new_server"}},
        {
          "type": "button",
          "label": "추가",
          "disabled": {"expr": "($url := $replace($trim($state.new_server), /\\/+$/, ''); $url = '' or $url in [($type($storage.servers) = 'array' ? $storage.servers : ($trim($storage.custom_url) != '' ? [$trim($storage.custom_url)] : [])).$replace($, /\\/+$/, '')] or $url = 'https://kaleidoscope.eiaserinnys.me/appstore')"},
          "on_click": [
            {
              "set_storage": {
                "entry": "servers",
                "value": {"expr": "($url := $replace($trim($state.new_server), /\\/+$/, ''); $url = '' or $url in [($type($storage.servers) = 'array' ? $storage.servers : ($trim($storage.custom_url) != '' ? [$trim($storage.custom_url)] : [])).$replace($, /\\/+$/, '')] or $url = 'https://kaleidoscope.eiaserinnys.me/appstore' ? ($type($storage.servers) = 'array' ? $storage.servers : ($trim($storage.custom_url) != '' ? [$trim($storage.custom_url)] : [])) : $append(($type($storage.servers) = 'array' ? $storage.servers : ($trim($storage.custom_url) != '' ? [$trim($storage.custom_url)] : [])), [$url]))"}
              }
            },
            {"set_state": "new_server", "value": ""}
          ]
        }
      ]
    }
  }
}
