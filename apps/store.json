                      "label": "스토어 판으로 바꾸기",
                      "disabled": {"expr": "$data_meta.convert.state = 'ready' ? $not($data.convert.compatible) : true"},
                      "on_click": [
                        {"store.install": {"permission": "catalog", "server": {"expr": "$data.convert.server"}, "id": {"state": "selected"}, "release": {"expr": "$data.convert.release"}, "replace": true}},
                        {"set_state": "selected", "value": null},
                        {"set_state": "selected_name", "value": ""},
                        {"set_state": "selected_store", "value": null},
                        {"set_state": "selected_key", "value": null},
                        {"set_state": "custom_store", "value": null}
                      ]
                    }
                  ]
