{
  "id": "test-agent",
  "name": "시험 에이전트",
  "requires": { "blocks": 8, "modules": { "local_agent": 1, "files": 1, "storage": 1 } },
  "permissions": [
    { "module": "local_agent", "id": "run", "label": "에이전트 실행" },
    { "module": "files", "id": "work", "access": "readwrite", "label": "작업 폴더" }
  ],
  "state": { "agent_id": null },
  "storage": {
    "entries": [{
      "id": "agents", "key": "settings/agents", "kind": "json", "label": "에이전트",
      "presentation": "hidden", "schema": { "type": "array" },
      "default": [{ "id": "sample", "name": "시험", "command": "test-agent", "args": [], "env": {} }]
    }]
  },
  "ui": {
    "type": "chat", "permission": "run", "root": { "permission": "work" },
    "agents": { "expr": "$storage.agents" }, "selected": { "state": "agent_id" },
    "on_select": { "set_state": "agent_id" }
  }
}
