  "ui": { "type": "stack", "direction": "column", "children": [
    { "type": "toolbar", "start": [{ "type": "button", "label": "짝수만 / 전체", "on_click": { "client": "filter" } }] },
    { "type": "repeat", "items": { "client": "swatches" }, "key": "id", "layout": "grid", "grid": { "columns": 3 }, "virtual": true,
      "template": { "type": "canvas", "surface": { "item": "surface" }, "aspect_ratio": 1, "description": { "item": "label" } } }
  ] }
