{
  "id": "localized-form",
  "name": "다국어 양식",
  "description": "세 언어 메시지로 탭과 입력 컨트롤을 바꾸는 예시",
  "requires": { "blocks": 16, "modules": { "assets": 1, "client": 1 } },
  "permissions": [],
  "state": {
    "language": "ko",
    "dialog_open": false,
    "enabled": false,
    "amount": 2,
    "color": "#4968a8",
    "name": "",
    "choice": null
  },
  "messages": {
    "ko": {
      "language_label": "표시 언어",
      "open_form": "양식 열기",
      "dialog_title": "연락처 정보",
      "save": "저장",
      "details_tab": "기본 설정",
      "more_tab": "안내",
      "more_content": "라벨과 입력 안내가 선택한 언어로 바뀝니다.",
      "enabled": "사용",
      "amount": "수량",
      "color": "색상",
      "name_label": "이름",
      "name_hint": "이름 입력",
      "choice_label": "항목",
      "choice_hint": "하나 고르기",
      "choice_one": "첫째",
      "choice_two": "둘째"
    },
    "en": {
      "language_label": "Display language",
      "open_form": "Open form",
      "dialog_title": "Contact details",
      "save": "Save",
      "details_tab": "Settings",
      "more_tab": "About",
      "more_content": "Labels and input hints follow the selected language.",
      "enabled": "Enabled",
      "amount": "Amount",
      "color": "Color",
      "name_label": "Name",
      "name_hint": "Type a name",
      "choice_label": "Choice",
      "choice_hint": "Choose one",
      "choice_one": "First",
      "choice_two": "Second"
    },
    "ja": {
      "language_label": "表示言語",
      "open_form": "フォームを開く",
      "dialog_title": "連絡先",
      "save": "保存",
      "details_tab": "設定",
      "more_tab": "案内",
      "more_content": "ラベルと入力案内が選択した言語に変わります。",
      "enabled": "有効",
      "amount": "数量",
      "color": "色",
      "name_label": "名前",
      "name_hint": "名前を入力",
      "choice_label": "項目",
      "choice_hint": "選択してください",
      "choice_one": "一つ目",
      "choice_two": "二つ目"
    }
  },
  "locale": { "state": "language" },
  "assets": [{ "id": "localized-form", "version": 1 }],
  "client": {
    "runtime": "javascript",
    "entry": { "id": "localized-form", "version": 1 },
    "inputs": { "language": { "state": "language" } },
    "outputs": {
      "language_options": { "default": [] },
      "choice_options": { "default": [] }
    },
    "actions": [],
    "commands": {},
    "state_keys": [],
    "storage_entries": []
  },
  "ui": {
    "type": "stack",
    "direction": "column",
    "children": [
      {
        "type": "button",
        "label": { "message": "open_form" },
        "on_click": [{ "set_state": "dialog_open", "value": true }]
      },
      {
        "type": "dialog",
        "open": { "state": "dialog_open" },
        "title": { "message": "dialog_title" },
        "on_close": [{ "set_state": "dialog_open", "value": false }],
        "child": {
          "type": "stack",
          "direction": "column",
          "children": [
            {
              "type": "select",
              "value": { "state": "language" },
              "on_change": { "set_state": "language" },
              "options": { "client": "language_options" },
              "label": { "message": "language_label" }
            },
          {
              "type": "tabs",
              "tabs": [
                {
                  "label": { "message": "details_tab" },
                  "child": {
                    "type": "stack",
                    "direction": "column",
                    "children": [
                      {
                        "type": "toggle",
                        "value": { "state": "enabled" },
                        "on_change": { "set_state": "enabled" },
                        "label": { "message": "enabled" }
                      },
                      {
                        "type": "slider",
                        "value": { "state": "amount" },
                        "on_change": { "set_state": "amount" },
                        "label": { "message": "amount" },
                        "min": 0,
                        "max": 10
                      },
                      {
                        "type": "color",
                        "value": { "state": "color" },
                        "on_change": { "set_state": "color" },
                        "label": { "message": "color" }
                      },
                      {
                        "type": "input",
                        "value": { "state": "name" },
                        "on_change": { "set_state": "name" },
                        "label": { "message": "name_label" },
                        "placeholder": { "message": "name_hint" }
                      },
                      {
                        "type": "select",
                        "value": { "state": "choice" },
                        "on_change": { "set_state": "choice" },
                        "options": { "client": "choice_options" },
                        "label": { "message": "choice_label" },
                        "placeholder": { "message": "choice_hint" }
                      }
                    ]
                  }
                },
                {
                  "label": { "message": "more_tab" },
                  "child": {
                    "type": "text",
                    "value": { "message": "more_content" }
                  }
                }
              ]
            },
            {
              "type": "button",
              "label": { "message": "save" },
              "on_click": [{ "set_state": "dialog_open", "value": false }]
            }
          ]
        }
      }
    ]
  }
}
