{
  "id": "localized-form",
  "name": "다국어 양식",
  "description": "세 언어 메시지로 탭과 입력 컨트롤을 바꾸는 예시",
  "requires": { "blocks": 16, "modules": { "assets": 1, "client": 1 } },
  "permissions": [],
  "state": {
    "language": "ko",
    "dialog_open": false,
    "tour_open": false,
    "tour_step": "language",
    "enabled": false,
    "amount": 2,
    "color": "#4968a8",
    "name": "",
    "choice": null
  },
  "messages": {
    "ko": {
      "language_label": "표시 언어",
      "open_form": "양식 열기",
      "dialog_title": "연락처 정보",
      "dialog_close": "닫기",
      "save": "저장",
      "open_tour": "안내 보기",
      "tour_previous": "이전",
      "tour_next": "다음",
      "tour_done": "끝내기",
      "tour_skip": "건너뛰기",
      "tour_language_title": "언어 선택",
      "tour_language_body": "표시 언어를 바꾸면 앱의 안내와 단추도 함께 바뀝니다.",
      "tour_name_title": "이름 입력",
      "tour_name_body": "이름을 입력하고 선택한 언어의 안내를 확인합니다.",
      "details_tab": "기본 설정",
      "more_tab": "안내",
      "more_content": "라벨과 입력 안내가 선택한 언어로 바뀝니다.",
      "enabled": "사용",
      "amount": "수량",
      "color": "색상",
      "name_label": "이름",
      "name_hint": "이름 입력",
      "choice_label": "항목",
      "choice_hint": "하나 고르기",
      "choice_one": "첫째",
      "choice_two": "둘째"
    },
    "en": {
      "language_label": "Display language",
      "open_form": "Open form",
      "dialog_title": "Contact details",
      "dialog_close": "Close",
      "save": "Save",
      "open_tour": "Show guide",
      "tour_previous": "Previous",
      "tour_next": "Next",
      "tour_done": "Done",
      "tour_skip": "Skip",
      "tour_language_title": "Choose a language",
      "tour_language_body": "Changing the display language also changes the app's guidance and buttons.",
      "tour_name_title": "Enter a name",
      "tour_name_body": "Enter a name and review the guidance in the selected language.",
      "details_tab": "Settings",
      "more_tab": "About",
      "more_content": "Labels and input hints follow the selected language.",
      "enabled": "Enabled",
      "amount": "Amount",
      "color": "Color",
      "name_label": "Name",
      "name_hint": "Type a name",
      "choice_label": "Choice",
      "choice_hint": "Choose one",
      "choice_one": "First",
      "choice_two": "Second"
    },
    "ja": {
      "language_label": "表示言語",
      "open_form": "フォームを開く",
      "dialog_title": "連絡先",
      "dialog_close": "閉じる",
      "save": "保存",
      "open_tour": "案内を見る",
      "tour_previous": "前へ",
      "tour_next": "次へ",
      "tour_done": "完了",
      "tour_skip": "スキップ",
      "tour_language_title": "言語を選ぶ",
      "tour_language_body": "表示言語を変えると、案内とボタンも切り替わります。",
      "tour_name_title": "名前を入力",
      "tour_name_body": "名前を入力し、選択した言語の案内を確認します。",
      "details_tab": "設定",
      "more_tab": "案内",
      "more_content": "ラベルと入力案内が選択した言語に変わります。",
      "enabled": "有効",
      "amount": "数量",
      "color": "色",
      "name_label": "名前",
      "name_hint": "名前を入力",
      "choice_label": "項目",
      "choice_hint": "選択してください",
      "choice_one": "一つ目",
      "choice_two": "二つ目"
    }
  },
  "locale": { "state": "language" },
  "assets": [{ "id": "localized-form", "version": 1 }],
  "client": {
    "runtime": "javascript",
    "entry": { "id": "localized-form", "version": 1 },
    "inputs": { "language": { "state": "language" } },
    "outputs": {
      "language_options": { "default": [] },
      "choice_options": { "default": [] }
    },
    "actions": [],
    "commands": {},
    "state_keys": [],
    "storage_entries": []
  },
  "ui": {
    "type": "stack",
    "direction": "column",
    "children": [
      {
        "type": "button",
        "label": { "message": "open_form" },
        "on_click": [{ "set_state": "dialog_open", "value": true }]
      },
      {
        "type": "dialog",
        "open": { "state": "dialog_open" },
        "title": { "message": "dialog_title" },
        "close_label": { "message": "dialog_close" },
        "on_close": [{ "set_state": "dialog_open", "value": false }],
        "child": {
          "type": "stack",
          "direction": "column",
          "children": [
            {
              "type": "anchor",
              "id": "language",
              "child": {
                "type": "select",
                "value": { "state": "language" },
                "on_change": { "set_state": "language" },
                "options": { "client": "language_options" },
                "label": { "message": "language_label" }
              }
            },
            {
              "type": "button",
              "label": { "message": "open_tour" },
              "on_click": [{ "set_state": "tour_open", "value": true }]
            },
            {
              "type": "tabs",
              "tabs": [
                {
                  "label": { "message": "details_tab" },
                  "child": {
                    "type": "stack",
                    "direction": "column",
                    "children": [
                      {
                        "type": "toggle",
                        "value": { "state": "enabled" },
                        "on_change": { "set_state": "enabled" },
                        "label": { "message": "enabled" }
                      },
                      {
                        "type": "slider",
                        "value": { "state": "amount" },
                        "on_change": { "set_state": "amount" },
                        "label": { "message": "amount" },
                        "min": 0,
                        "max": 10
                      },
                      {
                        "type": "color",
                        "value": { "state": "color" },
                        "on_change": { "set_state": "color" },
                        "label": { "message": "color" }
                      },
                      {
                        "type": "anchor",
                        "id": "name",
                        "child": {
                          "type": "input",
                          "value": { "state": "name" },
                          "on_change": { "set_state": "name" },
                          "label": { "message": "name_label" },
                          "placeholder": { "message": "name_hint" }
                        }
                      },
                      {
                        "type": "select",
                        "value": { "state": "choice" },
                        "on_change": { "set_state": "choice" },
                        "options": { "client": "choice_options" },
                        "label": { "message": "choice_label" },
                        "placeholder": { "message": "choice_hint" }
                      }
                    ]
                  }
                },
                {
                  "label": { "message": "more_tab" },
                  "child": {
                    "type": "text",
                    "value": { "message": "more_content" }
                  }
                }
              ]
            },
            {
              "type": "button",
              "label": { "message": "save" },
              "on_click": [{ "set_state": "dialog_open", "value": false }]
            },
            {
              "type": "tour",
              "open": { "state": "tour_open" },
              "step": { "state": "tour_step" },
              "steps": [
                {
                  "key": "language",
                  "target": "language",
                  "title": { "message": "tour_language_title" },
                  "body": { "message": "tour_language_body" }
                },
                {
                  "key": "name",
                  "target": "name",
                  "title": { "message": "tour_name_title" },
                  "body": { "message": "tour_name_body" }
                }
              ],
              "labels": {
                "previous": { "message": "tour_previous" },
                "next": { "message": "tour_next" },
                "done": { "message": "tour_done" },
                "skip": { "message": "tour_skip" }
              },
              "on_step": [{ "set_state": "tour_step", "value": { "expr": "$event" } }],
              "on_close": [{ "set_state": "tour_open", "value": false }]
            }
          ]
        }
      }
    ]
  }
}
