{
  "id": "card-board",
  "name": "카드 보드",
  "description": "서버에 등록한 연결에서 카드 목록을 받아 보고 상태를 바꾼다",
  "requires": { "blocks": 4, "modules": { "connection": 1 } },
  "permissions": [
    { "module": "connection", "id": "board", "connection": "board", "access": "readwrite", "label": "카드 보드" }
  ],
  "state": { "card": null, "query": "", "status": "all" },
  "sources": {
    "cards": { "kind": "request", "permission": "board", "path": "/api/cards", "refresh_secs": 60 },
    "detail": { "kind": "request", "permission": "board", "path": { "expr": "$state.card ? '/api/cards/' & $encodeUrlComponent($state.card)" } }
  },
  "ui": {
    "type": "split",
    "direction": "row",
    "sizes": [42, 58],
    "children": [
      {
        "type": "stack",
        "direction": "column",
        "gap": "none",
        "children": [
          {
            "type": "toolbar",
            "start": [
              { "type": "input", "kind": "search", "value": { "state": "query" }, "on_change": { "set_state": "query" }, "placeholder": "카드 찾기" }
            ],
            "end": [
              { "type": "select", "value": { "state": "status" }, "on_change": { "set_state": "status" }, "options": [{ "value": "all", "label": "전체" }, { "value": "running", "label": "진행" }, { "value": "review", "label": "검수" }, { "value": "done", "label": "완료" }] },
              { "type": "button", "label": "다시 받기", "icon": "refresh-cw", "icon_only": true, "variant": "ghost", "on_click": [{ "refresh": ["cards"] }] }
            ]
          },
          {
            "type": "list",
            "selected": { "state": "card" },
            "on_select": { "set_state": "card" },
            "items": { "expr": "$data.cards.cards[($state.status = 'all' or status = $state.status) and $contains($lowercase(title), $lowercase($state.query))]^(>updatedAt).{ \"key\": id, \"title\": title, \"meta\": '#' & $string(number), \"badges\": [{ \"text\": status, \"color\": status = 'done' ? '#2f7d4f' : status = 'blocked' ? '#a9363d' : '#315da8' }] }" }
          }
        ]
      },
      {
        "type": "stack",
        "direction": "column",
        "children": [
          {
            "type": "toolbar",
            "start": [
              { "type": "text", "style": "title", "value": { "expr": "$data.detail.card.title" } }
            ],
            "end": [
              {
                "type": "button",
                "label": "완료로",
                "icon": "check",
                "disabled": { "expr": "$not($exists($data.detail.card)) or $data.detail.card.status = 'done'" },
                "confirm": { "title": "완료로 바꿀까요?", "body": { "expr": "$data.detail.card.title" } },
                "on_click": [
                  { "call": { "permission": "board", "method": "POST", "path": { "expr": "'/api/cards/' & $encodeUrlComponent($state.card) & '/status'" }, "body": { "expr": "{ \"status\": \"done\" }" } } },
                  { "refresh": ["cards", "detail"] }
                ]
              }
            ]
          },
          {
            "type": "properties",
            "fields": [
              { "label": "상태", "value": { "expr": "$data.detail.card.status" }, "format": "badge" },
              { "label": "번호", "value": { "expr": "$data.detail.card.number" } },
              { "label": "고친 때", "value": { "expr": "$data.detail.card.updatedAt" }, "format": "date" },
              { "label": "요청", "value": { "expr": "$data.detail.card.request" }, "format": "markdown" }
            ]
          }
        ]
      }
    ]
  }
}
