{
  "id": "surface-gallery",
  "name": "표면 견본 모음",
  "description": "여러 묶음의 견본을 펼쳐 보고 스크롤합니다.",
  "requires": { "blocks": 14, "modules": { "assets": 1, "client": 2 } },
  "permissions": [],
  "state": {},
  "assets": [{ "id": "surface-gallery", "version": 1 }],
  "client": {
    "runtime": "javascript",
    "entry": { "id": "surface-gallery", "version": 1 },
    "inputs": {},
    "outputs": { "groups": { "default": [] } },
    "actions": ["toggle"],
    "commands": {},
    "state_keys": [],
    "storage_entries": []
  },
  "ui": {
    "type": "repeat", "items": { "client": "groups" }, "key": "id", "virtual": false,
    "template": {
      "type": "stack", "direction": "column", "gap": "small", "children": [
        { "type": "button", "label": { "item": "label" }, "on_click": { "client": "toggle" } },
        { "type": "when", "value": { "item": "open" }, "child": {
          "type": "repeat", "items": { "item": "items" }, "key": "id", "layout": "grid", "virtual": true,
          "template": { "type": "stack", "direction": "column", "children": [
            { "type": "canvas", "surface": { "item": "surface" }, "aspect_ratio": 1.6, "description": { "item": "label" } },
            { "type": "text", "value": { "item": "label" } }
          ] }
        } }
      ]
    }
  }
}
