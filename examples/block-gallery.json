{
  "id": "block-gallery",
  "name": "블록 견본",
  "description": "블록을 탭마다 모아 보인다",
  "requires": { "blocks": 34, "modules": { "files": 1 } },
  "permissions": [
    { "module": "files", "id": "media", "access": "read", "label": "이미지와 소리 폴더" },
    { "module": "files", "id": "notes", "access": "readwrite", "label": "설정 파일 폴더" }
  ],
  "state": {
    "tab": 0,
    "item": "b",
    "node": null,
    "query": "",
    "memo": "",
    "choice_input": "사과",
    "lang": "both",
    "compact": false,
    "count": 0,
    "amount": 1.5,
    "picture": null,
    "sound": null,
    "config": null,
    "timeline_selection": null
  },
  "sources": {
    "pictures": { "kind": "folder", "permission": "media", "recursive": true, "extensions": ["png", "jpg", "jpeg", "webp", "gif"] },
    "sounds": { "kind": "folder", "permission": "media", "recursive": true, "extensions": ["mp3", "wav", "ogg", "m4a", "mp4", "webm"] }
  },
  "ui": {
    "type": "tabs",
    "selected": { "state": "tab" },
    "on_change": { "set_state": "tab" },
    "tabs": [
      {
        "label": "목록",
        "child": {
          "type": "split",
          "direction": "row",
          "sizes": [40, 60],
          "children": [
            {
              "type": "stack",
              "direction": "column",
              "gap": "none",
              "children": [
                {
                  "type": "toolbar",
                  "start": [
                    { "type": "input", "kind": "search", "value": { "state": "query" }, "on_change": { "set_state": "query" }, "placeholder": "거르기" }
                  ],
                  "end": [
                    { "type": "toggle", "label": "격자", "value": { "state": "compact" }, "on_change": { "set_state": "compact" } }
                  ]
                },
                {
                  "type": "list",
                  "grouped": true,
                  "selected": { "state": "item" },
                  "on_select": { "set_state": "item" },
                  "items": { "expr": "( $q := $lowercase($state.query); $all := [{\"key\": \"a\", \"title\": \"첫 화면 다듬기\", \"subtitle\": \"화면\", \"meta\": \"10-28\", \"color\": \"#7a6bd1\", \"badges\": [{\"text\": \"완료\", \"color\": \"#2f7d4f\"}]}, {\"key\": \"b\", \"title\": \"연결 설계\", \"subtitle\": \"서버\", \"meta\": \"10-29\", \"color\": \"#d08a3c\", \"badges\": [{\"text\": \"진행\", \"color\": \"#315da8\"}]}, {\"key\": \"c\", \"title\": \"블록 견본\", \"subtitle\": \"화면\", \"meta\": \"10-30\", \"badges\": [\"새로\"]}, {\"key\": \"d\", \"title\": \"설치본 내기\", \"subtitle\": \"릴리스\", \"meta\": \"10-31\"}][$contains($lowercase(title), $q)]; [{\"title\": \"화면\", \"meta\": $string($count($all[subtitle = \"화면\"])), \"items\": [$all[subtitle = \"화면\"]]}, {\"title\": \"그 밖\", \"meta\": $string($count($all[subtitle != \"화면\"])), \"items\": [$all[subtitle != \"화면\"]]}][$count(items) > 0] )" }
                }
              ]
            },
            {
              "type": "properties",
              "fields": [
                { "label": "고른 항목", "value": { "state": "item" }, "format": "code" },
                { "label": "검색어", "value": { "expr": "$state.query = '' ? null : $state.query" } },
                { "label": "상태", "value": { "text": "진행", "color": "#315da8" }, "format": "badge" },
                { "label": "고친 때", "value": "2026-10-30T01:20:00Z", "format": "date" },
                { "label": "메모", "value": "**마크다운**으로 쓴 속성 값.\n두 줄째.", "format": "markdown" }
              ]
            }
          ]
        }
      },
      {
        "label": "표와 트리",
        "child": {
          "type": "split",
          "direction": "row",
          "sizes": [35, 65],
          "children": [
            {
              "type": "tree",
              "by": "path",
              "selected": { "state": "node" },
              "on_select": { "set_state": "node" },
              "items": [
                { "key": "1", "path": "화면/쉘/창.md", "meta": "3" },
                { "key": "2", "path": "화면/쉘/메뉴.md" },
                { "key": "3", "path": "화면/블록/목록.md", "badges": ["새로"] },
                { "key": "4", "path": "서버/연결.md" },
                { "key": "5", "path": "읽어 보기.md" }
              ]
            },
            {
              "type": "table",
              "sort": { "field": "updated", "desc": true },
              "selected": { "state": "node" },
              "on_select": { "set_state": "node" },
              "columns": [
                { "field": "title", "label": "제목" },
                { "field": "status", "label": "상태", "width": "narrow", "format": "badge" },
                { "field": "size", "label": "크기", "width": "narrow", "format": "number" },
                { "field": "updated", "label": "고친 때", "width": "medium", "format": "date" }
              ],
              "rows": [
                { "key": "1", "title": "창", "status": { "text": "완료", "color": "#2f7d4f" }, "size": 1204, "updated": "2026-10-28T09:00:00Z" },
                { "key": "2", "title": "메뉴", "status": "검토", "size": 380, "updated": "2026-10-29T12:30:00Z" },
                { "key": "3", "title": "목록", "status": { "text": "진행", "color": "#315da8" }, "size": 15020, "updated": "2026-10-30T01:10:00Z" },
                { "key": "4", "title": "연결", "status": { "text": "막힘", "color": "#a9363d" }, "size": 88, "updated": "2026-10-27T18:45:00Z" }
              ]
            }
          ]
        }
      },
      {
        "label": "흐름과 글",
        "child": {
          "type": "split",
          "direction": "row",
          "sizes": [55, 45],
          "children": [
            {
              "type": "stack",
              "direction": "column",
              "gap": "none",
              "children": [
                {
                  "type": "toolbar",
                  "start": [
                    { "type": "select", "style": "segmented", "value": { "state": "lang" }, "on_change": { "set_state": "lang" }, "options": [{ "value": "ko", "label": "한국어" }, { "value": "en", "label": "영어" }, { "value": "both", "label": "둘 다" }] }
                  ]
                },
                {
                  "type": "feed",
                  "grouped": true,
                  "entries": { "expr": "( $lines := [{\"key\": \"1\", \"name\": \"서소영\", \"color\": \"#7a6bd1\", \"ko\": \"먼저 짚고 넘어가겠습니다.\\n순서가 조금 다릅니다.\", \"en\": \"Let me point one thing out.\\nThe order is a little off.\"}, {\"key\": \"2\", \"name\": \"디렉터\", \"color\": \"#d08a3c\", \"ko\": \"그래, 고쳐 줘.\", \"en\": \"Sure, fix it.\"}]; $pick := function($l) { $state.lang = 'ko' ? [$l.ko] : $state.lang = 'en' ? [$l.en] : [$l.ko, $l.en] }; [{\"title\": \"대화\", \"meta\": $string($count($lines)), \"items\": [$lines.{\"key\": key, \"name\": name, \"color\": color, \"body\": $pick($)}]}, {\"title\": \"알림\", \"items\": [{\"key\": \"n\", \"body\": \"흐름 블록은 줄바꿈을 지킨다.\", \"tone\": \"muted\"}]}] )" }
                }
              ]
            },
            {
              "type": "stack",
              "direction": "column",
              "children": [
                {
                  "type": "section",
                  "title": "고른 언어",
                  "meta": { "state": "lang" },
                  "collapsible": true,
                  "child": { "type": "text", "value": { "expr": "'지금 보는 언어: ' & ($state.lang = 'ko' ? '한국어' : $state.lang = 'en' ? '영어' : '둘 다')" } }
                },
                {
                  "type": "section",
                  "title": "마크다운 글",
                  "child": { "type": "text", "format": "markdown", "value": "## 제목\n\n- 목록 하나\n- 목록 둘\n\n`코드`와 **굵은 글**." }
                }
              ]
            }
          ]
        }
      },
      {
        "label": "입력",
        "child": {
          "type": "stack",
          "direction": "column",
          "children": [
            {
              "type": "toolbar",
              "start": [
                { "type": "button", "label": "하나 더", "description": "횟수를 하나 늘립니다.", "icon": "plus", "variant": { "expr": "$state.count > 0 ? 'primary' : 'default'" }, "on_click": [{ "set_state": "count", "value": { "expr": "$state.count + 1" } }] },
                { "type": "button", "label": "되돌리기", "description": "횟수를 처음으로 돌립니다.", "icon": "rotate-ccw", "icon_only": true, "on_click": [{ "set_state": "count", "value": 0 }], "disabled": { "expr": "$state.count = 0" } },
                { "type": "text", "style": "meta", "value": { "expr": "$string($state.count) & '번'" } }
              ],
              "end": [
                { "type": "button", "label": "모두 지우기", "description": "현재 입력과 횟수를 모두 지우고 처음 상태로 되돌립니다.", "variant": "danger", "confirm": { "title": "모두 지울까요?", "body": { "expr": "'지금 ' & $string($state.count) & '번을 지웁니다.'" }, "ok": "지우기" }, "on_click": [{ "set_state": "count", "value": 0 }, { "set_state": "query", "value": "" }] }
              ]
            },
            {
              "type": "section",
              "title": "숫자 입력",
              "child": { "type": "stack", "direction": "row", "gap": "small", "children": [
                { "type": "input", "kind": "number", "label": "횟수", "value": { "state": "count" }, "min": 0, "max": 10, "on_change": { "set_state": "count" } },
                { "type": "input", "kind": "number", "spin": true, "label": "값", "value": { "state": "amount" }, "min": 0, "max": 5, "step": 0.5, "format": { "kind": "decimal", "digits": 1 }, "on_change": { "set_state": "amount" } }
              ] }
            },
            {
              "type": "section",
              "title": "글 입력",
              "child": { "type": "input", "multiline": true, "value": { "state": "query" }, "on_change": { "set_state": "query" }, "placeholder": "여러 줄 입력" }
            },
            {
              "type": "section",
              "title": "고르기",
              "child": { "type": "select", "value": { "state": "lang" }, "on_change": { "set_state": "lang" }, "options": [{ "value": "ko", "label": "한국어", "description": "한국어로 표시합니다." }, "en", "both"] }
            },
            {
              "type": "section",
              "title": "자동완성",
              "child": { "type": "input", "label": "이름", "value": { "state": "choice_input" }, "on_change": { "set_state": "choice_input" }, "options": [{ "value": "사과", "label": "사과", "description": "아삭한 과일입니다." }, { "value": "배", "label": "배", "description": "과즙이 풍부한 과일입니다." }, "귤"] }
            },
            {
              "type": "repeat",
              "layout": "grid",
              "grid": { "columns": "auto", "item_width": "small" },
              "key": "id",
              "items": [
                { "id": "clear", "label": "그림 고르기", "description": "현재 그림을 확인합니다." },
                { "id": "cloud", "label": "구름 고르기", "description": "구름 그림을 확인합니다." }
              ],
              "template": { "type": "button", "variant": "chip", "label": { "item": "label" }, "description": { "item": "description" }, "preview": { "type": "image", "src": { "state": "picture" } }, "on_click": [{ "set_state": "count", "value": 0 }] }
            }
          ]
        }
      },
      {
        "label": "코드",
        "child": {
          "type": "split",
          "direction": "row",
          "children": [
            {
              "type": "code",
              "read_only": true,
              "language": "json",
              "value": { "expr": "$string({\"tab\": $state.tab, \"item\": $state.item, \"count\": $state.count, \"lang\": $state.lang}, true)" }
            },
            {
              "type": "split",
              "direction": "column",
              "sizes": [35, 65],
              "children": [
                { "type": "tree", "root": { "permission": "notes" }, "extensions": ["json", "yaml", "yml", "toml"], "selected": { "state": "config" }, "on_select": { "set_state": "config" } },
                { "type": "code", "file": { "permission": "notes", "path": { "state": "config" } } }
              ]
            }
          ]
        }
      },
      {
        "label": "미디어",
        "child": {
          "type": "split",
          "direction": "row",
          "sizes": [45, 55],
          "children": [
            {
              "type": "tabs",
              "tabs": [
                {
                  "label": "그림",
                  "child": {
                    "type": "list",
                    "layout": "grid",
                    "selected": { "state": "picture" },
                    "on_select": { "set_state": "picture" },
                    "items": { "expr": "$data.pictures[kind = 'file'].{ \"key\": path, \"title\": name, \"meta\": $string($round(size / 1024)) & ' KB', \"image\": { \"permission\": \"media\", \"path\": path } }" }
                  }
                },
                {
                  "label": "소리",
                  "child": {
                    "type": "list",
                    "selected": { "state": "sound" },
                    "on_select": { "set_state": "sound" },
                    "items": { "expr": "$data.sounds[kind = 'file'].{ \"key\": path, \"title\": name, \"subtitle\": $substringBefore(path, name), \"meta\": ext }" }
                  }
                }
              ]
            },
            {
              "type": "split",
              "direction": "column",
              "sizes": [75, 25],
              "children": [
                { "type": "image", "zoom": true, "src": { "expr": "$state.picture ? { \"permission\": \"media\", \"path\": $state.picture }" } },
                { "type": "media", "autoplay": true, "src": { "expr": "$state.sound ? { \"permission\": \"media\", \"path\": $state.sound }" } }
              ]
            }
          ]
        }
      },
      {
        "label": "배치",
        "child": {
          "type": "split", "direction": "row", "column_below": 700, "sizes": [1, 1, 1],
          "children": [
            { "type": "split", "direction": "row", "column_below": 700, "children": [
              { "type": "section", "title": "메모", "child": { "type": "input", "value": { "state": "memo" }, "on_change": { "set_state": "memo" }, "placeholder": "내용" } },
              { "type": "text", "value": "분할 안의 분할" }
            ] },
            { "type": "section", "title": "목록 간격", "child": { "type": "repeat", "items": [{ "id": "첫째" }, { "id": "둘째" }, { "id": "셋째" }], "key": "id", "gap": "large", "template": { "type": "text", "value": { "item": "id" } } } },
            { "type": "section", "title": "격자 간격", "child": { "type": "repeat", "layout": "grid", "grid": { "columns": 2 }, "items": [{ "id": "가" }, { "id": "나" }, { "id": "다" }, { "id": "라" }], "key": "id", "gap": "large", "template": { "type": "text", "value": { "item": "id" } } } }
          ]
        }
      },
      {
        "label": "일정",
        "child": {
          "type": "timeline",
          "scale": "dates",
          "lanes": "each",
          "controls": true,
          "selection": { "state": "timeline_selection" },
          "on_select": { "set_state": "timeline_selection" },
          "off_days": ["2026-11-05", "2026-12-25"],
          "markers": [
            { "id": "m1", "time": "2026-11-13", "label": "검토" },
            { "id": "m2", "time": "2026-11-27", "label": "공유" },
            { "id": "m3", "time": "2026-12-18", "label": "마감" }
          ],
          "tracks": [
            { "id": "a", "label": "기획", "meta": "3건", "image": { "permission": "media", "path": "landscape.png" }, "items": [
              { "id": "a1", "label": "범위 정리", "start": "2026-01-05", "end": "2026-01-16", "tone": "accent", "muted": true },
              { "id": "a2", "label": "일정 검토", "start": "2026-11-09", "end": "2026-11-20", "tone": "warning" },
              { "id": "a3", "label": "추가 검토" }
            ] },
            { "id": "b", "label": "화면", "meta": "2건", "items": [
              { "id": "b1", "label": "화면 구성", "start": "2026-11-09", "end": "2026-11-27", "tone": "accent" },
              { "id": "b2", "label": "세부 화면", "start": "2026-11-23", "end": "2026-12-04" }
            ] },
            { "id": "c", "label": "자료", "meta": "2건", "items": [
              { "id": "c1", "label": "자료 수집", "start": "2026-11-04", "end": "2026-11-16", "tone": "success" },
              { "id": "c2", "label": "자료 검토", "start": "2026-11-17", "end": "2026-11-30" }
            ] },
            { "id": "d", "label": "구현", "items": [{ "id": "d1", "label": "첫 구현", "start": "2026-11-12", "end": "2026-12-02", "tone": "accent" }] },
            { "id": "e", "label": "연결", "items": [{ "id": "e1", "label": "연결 시험", "start": "2026-11-18", "end": "2026-12-08", "tone": "warning" }] },
            { "id": "f", "label": "검증", "items": [{ "id": "f1", "label": "기능 검증", "start": "2026-11-23", "end": "2026-12-10" }] },
            { "id": "g", "label": "기록", "items": [{ "id": "g1", "label": "문서 정리", "start": "2026-11-30", "end": "2026-12-11" }] },
            { "id": "h", "label": "품질", "items": [{ "id": "h1", "label": "오류 확인", "start": "2026-12-01", "end": "2026-12-14", "tone": "danger" }] },
            { "id": "i", "label": "운영", "items": [{ "id": "i1", "label": "운영 준비", "start": "2026-12-04", "end": "2026-12-15" }] },
            { "id": "j", "label": "공유", "items": [{ "id": "j1", "label": "공유 자료", "start": "2026-12-08", "end": "2026-12-16" }] },
            { "id": "k", "label": "최종 검토", "items": [{ "id": "k1", "label": "결과 검토", "start": "2026-12-14", "end": "2026-12-18", "tone": "success" }] },
            { "id": "l", "label": "후속", "items": [{ "id": "l1", "label": "후속 일정" }] }
          ]
        }
      }
    ]
  }
}
