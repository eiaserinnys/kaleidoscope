{
  "id": "client-host-services",
  "name": "파일과 기기 기능 예제",
  "description": "클라이언트가 만든 파일을 저장하고 공유합니다.",
  "requires": { "blocks": 14, "modules": { "assets": 1, "client": 2 } },
  "permissions": [],
  "state": {},
  "assets": [{ "id": "client-host-services", "version": 1 }],
  "client": {
    "runtime": "javascript",
    "entry": { "id": "client-host-services", "version": 1 },
    "inputs": {},
    "outputs": { "status": { "default": "저장할 파일을 만들 수 있습니다." } },
    "actions": ["save", "share", "keep_awake_on", "keep_awake_off"],
    "commands": {},
    "state_keys": [],
    "storage_entries": [],
    "capabilities": ["share", "keep_awake"]
  },
  "ui": {
    "type": "section",
    "title": null,
    "child": {
      "type": "stack",
      "direction": "column",
      "children": [
        { "type": "button", "label": "텍스트 저장", "on_click": { "client": "save" } },
        { "type": "button", "label": "텍스트 공유", "on_click": { "client": "share" } },
        { "type": "button", "label": "화면 켜짐 유지", "on_click": { "client": "keep_awake_on" } },
        { "type": "button", "label": "화면 켜짐 해제", "on_click": { "client": "keep_awake_off" } },
        { "type": "text", "value": { "client": "status" } }
      ]
    }
  }
}
