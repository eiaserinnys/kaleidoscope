{
  "id": "md-editor",
  "name": "마크다운 편집기",
  "description": "고른 폴더의 md 파일을 열어 원문 그대로 고친다",
  "requires": { "blocks": 1, "modules": { "files": 1 } },
  "permissions": [
    { "module": "files", "id": "docs", "access": "readwrite", "label": "문서 폴더" }
  ],
  "state": { "current_file": null },
  "ui": {
    "type": "split",
    "direction": "row",
    "sizes": [28, 72],
    "children": [
      {
        "type": "file_tree",
        "root": { "permission": "docs" },
        "extensions": ["md"],
        "selected": { "state": "current_file" },
        "on_select": { "set_state": "current_file" }
      },
      {
        "type": "markdown_editor",
        "file": { "permission": "docs", "path": { "state": "current_file" } }
      }
    ]
  }
}
