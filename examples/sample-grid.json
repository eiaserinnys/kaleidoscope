{
  "id": "sample-grid",
  "name": "표본 격자",
  "description": "입력 폭과 선택 가능한 표본 카드를 보여주는 예제입니다.",
  "requires": { "blocks": 19, "modules": { "assets": 1 } },
  "assets": [
    { "id": "builtin-weather-clear", "version": 1 },
    { "id": "builtin-weather-cloudy", "version": 1 }
  ],
  "permissions": [],
  "state": {
    "count": 4,
    "selected": "sun",
    "swatches": [
      {
        "id": "sun",
        "label": "햇살이 스며드는 밝고 부드러운 원형 장식 표본 카드",
        "image": { "asset": "builtin-weather-clear" }
      },
      {
        "id": "cloud",
        "label": "옅은 구름과 여백을 살린 차분하고 은은한 회색 장식 표본 카드",
        "image": { "asset": "builtin-weather-cloudy" }
      }
    ]
  },
  "ui": {
    "type": "stack",
    "direction": "column",
    "children": [
      {
        "type": "stack",
        "direction": "row",
        "wrap": true,
        "gap": "small",
        "children": [
          { "type": "input", "kind": "number", "columns": 4, "label": "표본 수", "value": { "state": "count" }, "on_change": { "set_state": "count" }, "min": 1, "max": 20, "step": 1 },
          { "type": "text", "value": "수치 입력은 지정한 글자 폭을 유지하고 이 설명은 남은 공간에서 줄바꿈됩니다." }
        ]
      },
      {
        "type": "repeat",
        "items": { "state": "swatches" },
        "key": "id",
        "layout": "grid",
        "grid": { "columns": 2 },
        "template": {
          "type": "button",
          "variant": "chip",
          "prefix": "색",
          "label": { "item": "label" },
          "preview": { "type": "image", "src": { "item": "image" } },
          "pressed": { "expr": "$state.selected = $item.id" },
          "on_click": [{ "set_state": "selected", "value": { "item": "id" } }]
        }
      }
    ]
  }
}
