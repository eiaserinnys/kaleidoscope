{
  "id": "sample-grid",
  "name": "표본 격자",
  "description": "입력 폭과 선택 가능한 표본 카드를 보여주는 예제입니다.",
  "requires": { "blocks": 19, "modules": { "assets": 1 } },
  "assets": [
    { "id": "builtin-weather-clear", "version": 1 },
    { "id": "builtin-weather-cloudy", "version": 1 }
  ],
  "permissions": [],
  "state": { "count": 4, "sun_selected": true, "cloud_selected": false },
  "ui": {
    "type": "stack",
    "direction": "column",
    "children": [
      {
        "type": "stack",
        "direction": "row",
        "wrap": true,
        "gap": "small",
        "children": [
          { "type": "input", "kind": "number", "columns": 4, "label": "표본 수", "value": { "state": "count" }, "on_change": { "set_state": "count" }, "min": 1, "max": 20, "step": 1 },
          { "type": "text", "value": "수치 입력은 지정한 글자 폭을 유지하고 이 설명은 남은 공간에서 줄바꿈됩니다." }
        ]
      },
      {
        "type": "stack",
        "direction": "row",
        "wrap": true,
        "gap": "small",
        "children": [
          {
            "type": "button",
            "variant": "chip",
            "prefix": "색",
            "label": "햇살이 스며드는 밝고 부드러운 원형 장식 표본 카드",
            "preview": { "type": "image", "src": { "asset": "builtin-weather-clear" } },
            "pressed": { "state": "sun_selected" },
            "on_click": [{ "set_state": "sun_selected", "value": { "expr": "$state.sun_selected ? false : true" } }]
          },
          {
            "type": "button",
            "variant": "chip",
            "prefix": "색",
            "label": "옅은 구름과 여백을 살린 차분하고 은은한 회색 장식 표본 카드",
            "preview": { "type": "image", "src": { "asset": "builtin-weather-cloudy" } },
            "pressed": { "state": "cloud_selected" },
            "on_click": [{ "set_state": "cloud_selected", "value": { "expr": "$state.cloud_selected ? false : true" } }]
          }
        ]
      }
    ]
  }
}
